<!doctype html><html><head><meta charset="utf-8"><style>
@page{size:A4 landscape;margin:0}*{box-sizing:border-box}body{margin:0;background:#f3eee1;color:#1a1a18;font-family:'Plus Jakarta Sans',system-ui,-apple-system,'Segoe UI',sans-serif}.sheet{width:297mm;height:210mm;padding:9mm 10mm 7mm;page-break-after:always;overflow:hidden;display:flex;flex-direction:column;gap:2.5mm}.sheet:last-child{page-break-after:auto}.mast{height:12mm;border-bottom:1px solid #1a1a18;display:grid;grid-template-columns:1fr auto 1fr;align-items:center}.brand{font-size:8pt;font-weight:800;letter-spacing:.08em}.brand i{color:#d01012}.fixture{display:flex;align-items:center;gap:3mm;font-size:9pt;font-weight:800}.fixture img{width:7mm;height:7mm;object-fit:contain}.fixture strong{font-size:11pt}.folio{text-align:right;color:#6f6a5d;font-size:5.8pt;text-transform:uppercase;line-height:1.45}.head{height:8mm;border-bottom:.7px solid #cfc7b4;display:flex;align-items:center}.head b{font-size:7pt;text-transform:uppercase;letter-spacing:.1em}.head b:before,.card h2:before{content:'■';color:#d01012;font-size:5pt;margin-right:1.5mm}.head span{margin-left:auto;color:#6f6a5d;font-size:6.4pt;font-style:italic;font-family:'Spectral','Iowan Old Style',Georgia,serif}.foot{margin-top:auto;text-align:center;color:#6f6a5d;font-size:5.5pt}.titlebody{flex:1;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center}.title .num{font:italic 800 38pt Georgia;color:#d01012}.title h1{font-size:24pt;letter-spacing:.14em;text-transform:uppercase;margin:1mm}.title p{font:italic 9pt 'Spectral','Iowan Old Style',Georgia,serif;color:#6f6a5d;max-width:165mm}.contents{margin-top:7mm;text-align:left;font-size:6.5pt;font-weight:700;line-height:1.8;text-transform:uppercase}.contents span:before{content:'■';color:#d01012;margin-right:2mm}.grid2{display:grid;grid-template-columns:1fr 1fr;gap:3mm;min-height:0;flex:1}.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:3mm;min-height:0;flex:1}.card{border:.6px solid #cfc7b4;padding:2mm;display:flex;flex-direction:column;min-height:0;overflow:hidden}.card h2{font-size:6.5pt;text-transform:uppercase;letter-spacing:.08em;margin:0 0 1mm;border-bottom:.4px solid #ded6c4;padding-bottom:1mm}.card h3{font-size:6pt;margin:0 0 1mm;text-transform:uppercase}.chart{width:100%;height:100%;object-fit:contain;min-height:0}.score{font-size:17pt;font-weight:800}.muted{color:#6f6a5d;font-size:6pt}.stats{font-size:6pt}.stat{display:grid;grid-template-columns:1fr 15mm 15mm 15mm;gap:2mm;border-bottom:.35px solid #ded6c4;padding:.9mm .65mm .3mm}.stat b{text-align:right}.stat .bl{color:#918c7a}.stat .good{color:#3f7d4f}.stat .bad{color:#b23b2e}.stat-group{font-size:5.3pt;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:#96907d;margin-top:1.6mm;padding:.8mm .65mm 0}.statbar{grid-column:1/5;height:1.3mm;background:#7d7869;margin:0 .65mm;position:relative}.statbar i{position:absolute;left:0;top:0;bottom:0;background:#d01012;display:block}.kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:2mm}.kpi{border-top:1.5px solid #d01012;padding:2mm}.kpi b{font-size:17pt;color:#d01012;display:block}.kpi span{font-size:5.5pt;text-transform:uppercase}.hero{flex:1;min-height:0}.hero img{width:100%;height:100%;object-fit:contain}.support{height:43mm}.table{width:100%;border-collapse:collapse;font-size:5.8pt}.table td,.table th{padding:.8mm;border-bottom:.35px solid #ded6c4;text-align:right}.table td:first-child,.table th:first-child{text-align:left}.red{color:#d01012}.grey{color:#7d7869}.p2{grid-template-columns:1.15fr .85fr}.highlights{height:31mm;display:grid;grid-template-columns:repeat(3,1fr);gap:2mm}.flow{display:grid;grid-template-rows:1fr 1fr;gap:2mm;flex:1;min-height:0}.p9{display:grid;grid-template-columns:1fr 1.45fr;grid-template-rows:1fr 55mm;gap:2mm;flex:1;min-height:0}.span2{grid-column:1/3}.p10top{display:grid;grid-template-columns:1fr 1fr .48fr;gap:2mm;height:104mm}.p10bottom{display:grid;grid-template-columns:1fr 1fr;gap:2mm;flex:1}.p12{grid-template-columns:.72fr 1.28fr}.p14{grid-template-columns:1.25fr .75fr}.stack2{display:grid;grid-template-rows:1fr 1fr;gap:2mm;min-height:0}.duelgrid{display:grid;grid-template-columns:1fr 1fr;gap:3mm;flex:1}.widechart{height:100%;width:100%;object-fit:contain}
</style></head><body>
{% macro mast(section,page_str) %}<div class="mast"><div class="brand">CAFC <i>Analyst</i> REPORT</div><div class="fixture">{% for s in sides %}{% if s.badge %}<img src="{{s.badge}}">{% endif %}<span class="{{'red' if s.is_charlton else 'grey'}}">{{s.team}}</span>{% if loop.first %}<strong>{{s.goals}} - {{sides[1].goals}}</strong>{% endif %}{% endfor %}</div><div class="folio">{{meta.date}} · {{meta.competition}}<br>{{section}} · {{page_str}}</div></div>{% endmacro %}
{% macro header(name,section,page_str,caption='') %}{{mast(section,page_str)}}<div class="head"><b>{{name}}</b><span>{{caption}}</span></div>{% endmacro %}
{% macro panel(name,caption='') %}<div class="head"><b>{{name}}</b><span>{{caption}}</span></div>{% endmacro %}
{% macro footer(n) %}<div class="foot">{{n}}/16</div>{% endmacro %}
<section class="sheet title">{{mast('Overview','DIVIDER')}}<div class="titlebody"><div class="num">1</div><h1>Overview</h1><p>Match stats, team performance profile and how the game unfolded.</p><div class="contents"><span>Match stats & team performance</span><br><span>Match flow & xG race</span></div></div>{{footer(1)}}</section>
<section class="sheet">{{header('Match Stats & Team Performance','Overview','PAGE 1/2','Baseline: compared to 25/26 averages')}}<div class="grid2 p2"><div class="card"><h2>Match Stats</h2><div class="stats">{% for r in stat_rows_expanded %}{% if r.group %}<div class="stat-group">{{r.group}}</div>{% endif %}<div class="stat"><span>{{r.label}}</span><b>{{r.home}}</b><b>{{r.away}}</b><b class="bl {{r.shade or ''}}">{{r.baseline}}</b></div><div class="statbar"><i style="width:{{r.home_share}}%"></i></div>{% endfor %}</div></div><div class="card"><h2>Team Performance</h2><img class="chart" src="{{performance_img}}"></div></div><div class="highlights">{% for text in match_highlights %}<div class="card"><h2>Match Highlights</h2><p class="muted">{{text}}</p></div>{% endfor %}</div>{{footer(2)}}</section>
<section class="sheet">{{mast('Overview','PAGE 2/2')}}<div class="flow"><div class="card">{{panel('Match Flow / Territory','rolling 3-min mean tracked ball position — red = '+subject+"'s attacking half, grey = "+opponent+"'s")}}<img class="chart" src="{{territory_img}}"></div><div class="card">{{panel('xG Race','cumulative non-penalty xG, goals marked')}}<img class="chart" src="{{xg_race_img}}"></div></div>{{footer(3)}}</section>
<section class="sheet title">{{mast('In Possession','DIVIDER')}}<div class="titlebody"><div class="num">2</div><h1>In Possession</h1><p>How both teams built play, how the attacking threat was created, and how chance quality compared.</p><div class="contents"><span>Separate passing networks</span><br><span>Team-by-team phase shapes</span><br><span>Threat density, entries & player threat</span><br><span>Comparative shot maps & xG sources</span></div></div>{{footer(4)}}</section>
{% for team in team_order %}<section class="sheet">{{header(team.upper()+' PASSING NETWORK','In Possession','PAGE '+loop.index|string+'/6','starting XI · shared match scales')}}<div class="card hero"><img class="chart" src="{{network[team]}}"><p class="muted" style="text-align:center">Node Size = pass volume &nbsp;·&nbsp; Node Colour = Passing Threat −{{network_scale_threat}}...+{{network_scale_threat}} &nbsp;·&nbsp; Link Width = pass volume &nbsp;·&nbsp; Link Colour = Pair Passing Threat &nbsp;·&nbsp; purple = lost &nbsp;·&nbsp; green = gained</p></div>{{footer(5+loop.index0)}}</section>{% endfor %}
{% for team in team_order %}<section class="sheet">{{header(team+' · Average Positions','In Possession','PAGE '+(2+loop.index)|string+'/6')}}<div class="grid2">{% for phase in ['avg_pos_in','avg_pos_out'] %}<div class="card">{{panel(team.upper(),'starting XI · attacking upwards')}}<div class="muted" style="padding:0 .65mm">{{'IN POSSESSION' if phase=='avg_pos_in' else 'OUT OF POSSESSION'}}</div>{% if side_by_team[team][phase] %}<img class="chart" src="{{side_by_team[team][phase]}}">{% else %}<p class="muted">Tracked phase unavailable</p>{% endif %}</div>{% endfor %}</div>{{footer(7+loop.index0)}}</section>{% endfor %}
<section class="sheet">{{header('Threat Creation','In Possession','PAGE 5/6')}}<div class="p9"><div class="card">{{panel('Threat Density Map','positive PXT Attack · action start')}}<img class="chart" src="{{threat_img}}"><div class="muted" style="text-align:center">{{threat_pxt}} positive PXT Attack · {{threat_actions}} actions</div></div><div class="card">{{panel('Final Third Entries & Box Entries','route · outcome · destination')}}<img class="chart" src="{{side_by_team[subject].entries}}"></div><div class="card span2">{{panel('Player Threat Ranking','open-play creation · goals excluded')}}<table class="table"><tr><th>Player</th><th>Passes</th><th>xG</th><th>xT</th></tr>{% for p in contributions %}<tr><td>{{p.name}}</td><td>{{p.passes}}</td><td>{{p.xg}}</td><td>{{p.xt}}</td></tr>{% endfor %}</table></div></div>{{footer(9)}}</section>
<section class="sheet">{{header('Shots & Chance Sources','In Possession','PAGE 6/6')}}<div class="p10top">{% for s in sides %}<div class="card"><h2>{{s.team}} Shot Map</h2><img class="chart" src="{{s.shot_map}}"><div class="muted">{{s.shot_summary.shots}} shots · {{'%.2f'|format(s.shot_summary.xg)}} xG</div></div>{% endfor %}<div class="card"><h2>Chance Source</h2><img class="chart" src="{{chance_source_img}}"></div></div><div class="p10bottom">{% for team in team_order %}<div class="card"><h2>Biggest Chances · {{team}}</h2><table class="table">{% for c in big_chances[team] %}<tr><td>{{c.minute}}</td><td>{{c.player}}</td><td>{{'%.2f'|format(c.xg)}} xG</td><td>{{c.result}}</td></tr>{% endfor %}</table></div>{% endfor %}</div>{{footer(10)}}</section>
<section class="sheet title">{{mast('Out of Possession','DIVIDER')}}<div class="titlebody"><div class="num">3</div><h1>Out of Possession</h1><p>Where the team engaged, competed and recovered the ball.</p><div class="contents"><span>Pressure activity & spatial duel performance</span><br><span>Opposition-half regains & second balls</span></div></div>{{footer(11)}}</section>
<section class="sheet">{{header('Pressure Activity & Duel Performance','Out of Possession','PAGE 1/3')}}<div class="grid2 p12"><div class="card"><h2>Pressure Activity</h2><img class="chart" src="{{pressure_img}}"><div class="kpis"><div class="kpi"><b>{{pressure_kpis.opp_half_pct}}%</b><span>Opposition-half share</span></div><div class="kpi"><b>{{pressure_kpis.opp_third_n}}</b><span>Opposition-third pressures</span></div><div class="kpi"><b>—</b><span>Median intensity</span></div><div class="kpi"><b>{{pressure_kpis.top_name}}</b><span>Top presser · {{pressure_kpis.top_n}}</span></div></div></div><div class="card"><h2>{{subject}} Duel Performance</h2><div class="grid2"><div><h3>Aerial</h3><img class="chart" src="{{aerial_duel_img}}"></div><div><h3>Ground</h3><img class="chart" src="{{ground_duel_img}}"></div></div></div></div>{{footer(12)}}</section>
<section class="sheet">{{header('Player Duel Performance','Out of Possession','PAGE 2/3','top five by involvement · both teams')}}<div class="stack2"><div class="card"><h3>Aerial Duels</h3><img class="widechart" src="{{duel_aerial_bars_img}}"></div><div class="card"><h3>Ground Duels</h3><img class="widechart" src="{{duel_ground_bars_img}}"></div></div>{{footer(13)}}</section>
<section class="sheet">{{header('Regains & Second Balls','Out of Possession','PAGE 3/3')}}<div class="grid2 p14"><div class="stack2"><div class="card"><h2>Opposition-Half Regains</h2><div class="score red">{{regain_kpis.shot_pct}}%</div><p class="muted">of {{regain_kpis.n}} regains led to a shot within 15s ({{regain_kpis.shot_n}} of {{regain_kpis.n}})</p><img class="chart" src="{{regain_img}}"></div><div class="card"><h2>Player Recoveries</h2><img class="chart" src="{{recovery_player_img}}"></div></div><div class="card"><h2>Second-Ball Wins</h2><div class="score red">{{second_ball_kpis.won_pct}}%</div><p class="muted">of {{second_ball_kpis.n}} second-ball contests won ({{second_ball_kpis.won_n}} of {{second_ball_kpis.n}})</p><img class="chart" src="{{second_ball_img}}"></div></div>{{footer(14)}}</section>
<section class="sheet title">{{mast('Transition','DIVIDER')}}<div class="titlebody"><div class="num">4</div><h1>Transition</h1><p>Whether the team was deliberate or impulsive after losing the ball.</p><div class="contents"><span>High attacking-half losses</span><br><span>Counter-press regains</span><br><span>Losses leading to shots</span></div></div>{{footer(15)}}</section>
<section class="sheet">{{header('Defensive Transition Response','Transition','PAGE 1/1','what happened after '+subject+' lost the ball in the attacking half')}}<div class="card hero"><h2>High losses, counter-press regains & opposition shots conceded</h2><img class="chart" src="{{transition_img}}"></div><div class="kpis"><div class="kpi"><b>{{transition_kpis.high_losses_n}}</b><span>High losses</span></div><div class="kpi"><b>{{transition_kpis.counterpress_n}}</b><span>Counter-press regains</span></div><div class="kpi"><b>{{transition_kpis.shot_n}}</b><span>Led to opponent shot</span></div><div class="kpi"><b>{{transition_kpis.shot_pct}}%</b><span>Loss-to-shot rate</span></div></div>{{footer(16)}}</section>
</body></html>
