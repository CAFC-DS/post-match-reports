{% macro mast(section,page_str) %}<div class="mast"><div class="brand">CAFC <i>Analyst</i> REPORT</div><div class="fixture">{% for s in sides %}{% if s.badge %}<img src="{{s.badge}}">{% endif %}<span class="{{'red' if s.is_charlton else 'grey'}}">{{s.team}}</span>{% if loop.first %}<strong>{{s.goals}} - {{sides[1].goals}}</strong>{% endif %}{% endfor %}</div><div class="folio">{{meta.date}} · {{meta.competition}}<br>{{section}}{% if page_str %} · {{page_str}}{% endif %}</div></div>{% endmacro %}
{% macro header(name,section,page_str,caption='') %}{{mast(section,page_str)}}<div class="head"><b>{{name}}</b><span>{{caption}}</span></div>{% endmacro %}
{% macro panel(name,caption='') %}<div class="panelhead"><b>{{name}}</b><span>{{caption}}</span></div>{% endmacro %}
{% macro footer(key) %}<div class="foot">{{page_plan.pages[key].n}}/{{page_plan.total}}</div>{% endmacro %}
{% macro label(key) %}{{page_plan.pages[key].label}}{% endmacro %}
{% macro divider(section,key) %}{% set sec=section_info[section] %}<section class="sheet title">{{mast(sec.title,label(key))}}<div class="titlebody"><div class="num">{{sec.num}}</div><h1>{{sec.title}}</h1><hr><p>{{sec.blurb}}</p><div class="contents">{% for it in sec['items'] %}<span>{{it}}</span>{% if not loop.last %}<br>{% endif %}{% endfor %}</div></div>{{footer(key)}}</section>{% endmacro %}
<section class="sheet">{{mast('Contents',label('contents'))}}<div class="tochead"><b>Contents</b><span>what's in this report and where to find it</span></div><div class="toc">{% for r in contents %}<div class="toc-row"><div class="toc-num">{{r.num}}</div><div class="toc-main"><div class="toc-title"><b>{{r.title}}</b><span>{{r.pages}}</span></div><p>{{r.blurb}}</p><div class="toc-items">{% for it in r['items'] %}<span>{{it}}</span>{% endfor %}</div></div></div>{% endfor %}</div>{{footer('contents')}}</section>
{{divider('overview','div_overview')}}
{% if team_sheets %}<section class="sheet">{{header('Team Sheet, Lineups & Timeline','Overview',label('ov_sheet'),'starters, substitutes and how the match unfolded')}}<div class="summary">{% for t in team_sheets %}{% if loop.index0==1 %}<div class="summid"><div class="ht">Half-time {{team_sheets[0].ht}} – {{team_sheets[1].ht}}</div>{% for k in summary_kpis %}<div class="kpirow"><span>{{k.subject}}</span><em>{{k.label}}</em><span>{{k.opponent}}</span></div>{% endfor %}</div>{% endif %}<div class="sumteam {{'cha' if t.is_charlton else 'opp'}}"><div class="tn">{{t.name}}</div><div class="sc">{{t.score}}</div><ul>{% for g in t.goals %}<li><b>{{g.min}}</b> {{g.who}}{% if g.assist %} <i>(assist {{g.assist}})</i>{% endif %}</li>{% endfor %}</ul></div>{% endfor %}</div><div class="sheetgrid">{% for t in team_sheets %}<div class="card">{{panel(t.name.upper(),'formation '~t.formation~' · roles as tagged by Impect')}}<div class="sheetbody">{% if t.lineup_img %}<img class="lineupimg" src="{{t.lineup_img}}">{% endif %}<table class="sheettable"><tr><th>#</th><th>Player</th><th>Pos</th><th>Min</th><th>Events</th></tr>{% for grp in [t.starters,t.subs] %}{% if loop.index0==1 %}<tr class="subhead"><td colspan="5">Substitutes used</td></tr>{% endif %}{% for r in grp %}<tr><td class="n">{{r.shirt}}</td><td>{{r.name}}</td><td class="pos">{{r.role}}</td><td class="min">{{r.minutes}}'</td><td>{% for m in r.marks %}<span class="mk {{m.kind}}">{{ {'goal':'●','assist':'○','yellow':'▮','red':'▮','on':'▲','off':'▼'}[m.kind] }}{{m.text}}</span>{% endfor %}</td></tr>{% endfor %}{% endfor %}</table></div><div class="unused">● goal · ○ assist · <span style="color:#c0892d">▮</span> yellow · <span style="color:#a00d0f">▮</span> red · ▲ on · ▼ off{% if t.unused %}<br>Unused substitutes: {{t.unused_names|join(', ')}}{% endif %}</div></div>{% endfor %}</div>{{footer('ov_sheet')}}</section>{% endif %}
<section class="sheet">{{header('Match Stats & Team Performance','Overview',label('ov_stats'),'Baseline: compared to 25/26 averages')}}<div class="grid2 p2"><div class="card"><h2>Match Stats</h2><div class="stats"><div class="statshead"><span></span><b>{{meta.home_team.upper()}}</b><span></span><b class="away">{{meta.away_team.upper()}}</b><b>CAFC BASELINE</b></div>{% for r in stat_rows_expanded %}{% if r.group %}<div class="stat-group">{{r.group}}</div>{% endif %}<div class="stat"><span>{{r.label}}</span><b class="{{'cha' if r.home_is_charlton else 'opp'}} {{'hw' if r.home_wins else ''}}">{{r.home}}</b><div class="statbar"><i class="{{'cha' if r.home_is_charlton else 'opp'}}" style="width:{{r.home_share}}%"></i><i class="{{'opp' if r.home_is_charlton else 'cha'}}" style="width:{{r.away_share}}%"></i></div><b class="away {{'opp' if r.home_is_charlton else 'cha'}} {{'hw' if r.away_wins else ''}}">{{r.away}}</b><b class="bl {{r.shade or ''}}">{{r.baseline}}</b></div>{% endfor %}</div></div><div class="card"><h2>Team Performance</h2><img class="chart" src="{{performance_img}}"></div></div><div class="card highlights-card">{{panel('Match Highlights','three takeaways')}}<div class="highlights">{% for text in match_highlights %}<div class="hl-item"><p>{{text}}</p></div>{% endfor %}</div></div>{{footer('ov_stats')}}</section>
<section class="sheet">{{mast('Overview',label('ov_flow'))}}<div class="flow"><div class="card">{{panel('Match Flow, Territory & Timeline',('rolling 3-min mean tracked ball position' if territory_is_tracked else 'rolling five-minute net packing xT · IMPECT event data')+' — red = '+subject+"'s attacking half, grey = "+opponent+"'s · goals, cards and substitutions marked")}}<img class="chart" src="{{flow_timeline_img}}"></div><div class="card">{{panel('xG Race','cumulative non-penalty xG, goals marked')}}<img class="chart" src="{{xg_race_img}}"></div></div>{{footer('ov_flow')}}</section>
{{divider('in_possession','div_ip')}}
<section class="sheet">{{header('Passing Networks & Progression','In Possession',label('net'),'starting XI · shared match scales · progression by packing-zone role')}}<div class="net4">{% for team in team_order %}{% set kp=progression_kpis[team] %}<div class="card">{{panel(team.upper()+' · PASSING NETWORK','starting XI · node = pass volume, colour = passing threat')}}<img class="chart" src="{{network[team]}}"></div><div class="card">{{panel(team.upper()+' · PROGRESSION',kp.total|string+' opponents ('+kp.defenders|string+' defenders) bypassed by '+kp.actions|string+' passes & carries')}}<img class="chart" src="{{progression_img[team]}}"></div>{% endfor %}</div><div class="netlegend"><span class="lg-size"><i></i><i></i><i></i> Node Size = Pass Volume</span><span class="lg-grad">Node Colour = Passing Threat <b>−{{network_scale_threat}}</b><span class="lg-bar"></span><b>+{{network_scale_threat}}</b></span><span class="lg-width"><i></i> Link Width = Pass Volume</span><span class="lg-grad">Link Colour = Pair Passing Threat<span class="lg-bar"></span></span><span>Purple = Lost · Green = Gained</span></div><div class="muted" style="text-align:center">Progression: large number = opponents bypassed, small = defenders bypassed, by passes and carries that reached that role. The zone is the role of the player the ball reached, not where the opponents stood (a keeper-to-def-mid pass that skips two forwards counts 2 under 'To def. mid') · own goal on the left · same scale for both teams</div>{{footer('net')}}</section>
{% if tracked_shapes %}{% for team in team_order %}<section class="sheet">{{mast('In Possession',label('shapes_'~loop.index0))}}<div class="grid2">{% for phase in ['avg_pos_in','avg_pos_out'] %}<div class="card">{{panel(team.upper(),'starting XI · attacking upwards')}}<div class="phaselabel">{{'IN POSSESSION' if phase=='avg_pos_in' else 'OUT OF POSSESSION'}}</div><img class="chart" src="{{side_by_team[team][phase]}}">{% set lh = side_by_team[team][phase+'_lh'] %}{% if lh %}<div class="lhcaption">Defensive Line Height: {{'%.0f'|format(lh)}}m</div>{% endif %}</div>{% endfor %}</div>{{footer('shapes_'~loop.index0)}}</section>{% endfor %}{% else %}<section class="sheet">{{mast('In Possession',label('shapes'))}}<div class="grid2">{% for team in team_order %}<div class="card">{{panel(team.upper(),'starting XI · attacking left to right')}}<div class="phaselabel">IN POSSESSION · IMPECT EVENT DATA</div><img class="chart" src="{{side_by_team[team].avg_pos_in}}">{% if side_by_team[team].avg_pos_in_lh %}<div class="lhcaption">Event-derived back-line estimate: {{'%.0f'|format(side_by_team[team].avg_pos_in_lh)}}m</div>{% endif %}<div class="muted" style="text-align:center">Mean location of each starter's IMPECT-tagged in-possession actions; event locations, not tracking.</div></div>{% endfor %}</div>{{footer('shapes')}}</section>{% endif %}
<section class="sheet">{{header('Where Players Received The Ball','In Possession',label('ip_receptions'),'by the packing-zone role of the receiver · as tagged by Impect · build-up receptions and headers left out')}}<div class="grid2">{% for team in team_order %}{% set rc=reception_ctx[team] %}<div class="card">{{panel(team.upper(),rc.total|string+' receptions · '+rc.bypassed|string+' opponents bypassed')}}<img class="chart recimg" src="{{rc.img}}"><div class="catstrip">{% for c in rc.categories %}<div><b>{{c.n}}</b><span>{{c.label}}</span></div>{% endfor %}</div><table class="rectable"><tr><th>Top receivers</th><th>Received</th><th>Bypassed</th><th>xT gained</th></tr>{% for p in rc.players %}<tr><td>{{p.name}}</td><td>{{p.receptions}}</td><td class="b">{{p.bypassed}}</td><td>{{'%.3f'|format(p.xt)}}</td></tr>{% endfor %}</table><div class="muted" style="padding-top:1mm">map: large number = opponents bypassed on receiving, small = receptions · own goal on the left · same scale for both teams</div></div>{% endfor %}</div>{{footer('ip_receptions')}}</section>
<section class="sheet">{{header('Threat Creation & Player Threat','In Possession',label('ip_threat_zones'),'density and role zones above, player threat below · same scale for both teams')}}<div class="grid2">{% for team in team_order %}{% set td=threat_density_kpis[team] %}{% set tz=threat_zone_kpis[team] %}{% set pt=player_threat_ctx[team] %}<div class="card">{{panel(team.upper(),'threat created (passing + carrying) '+pt.created+' · receiving '+pt.receiving)}}<div class="tmaps"><div><div class="mini">Threat density · {{td.pxt}} positive PXT · {{td.actions}} actions</div><img src="{{threat_density_img[team]}}"></div><div><div class="mini">Threat by role zone · {{tz.total}} xT</div><img src="{{threat_zone_img[team]}}"></div></div><div class="mini" style="margin-top:2.4mm">Player threat · top 8 by passing, carrying and receiving</div><img class="ptimg" src="{{pt.img}}"></div>{% endfor %}</div><div class="muted" style="text-align:center;padding-top:1mm">Role zones: positive threat of passes and carries by the role they reached (goals and lost passes excluded); zones follow each team's shape, own goal on the left. Player threat: Impect credits a completed move to the passer or carrier and to the receiver, so the three are separate rankings, not shares of one total; passing + carrying is the threat-created measure used elsewhere · goals excluded</div>{{footer('ip_threat_zones')}}</section>
<section class="sheet">{{header('Final Third & Box Entries','In Possession',label('ip_entries'),'route · outcome · destination · who got the ball there')}}<div class="p9c">{% for team in team_order %}{% set sp=side_by_team[team].entries_style_split %}<div class="card">{{panel(team.upper()+' ENTRIES','route · outcome · destination')}}<img class="chart" src="{{side_by_team[team].entries}}"><div class="splitline">{% if line_breaks_available %}<b>{{'%.0f'|format(sp.through)}}%</b> through · <b>{{'%.0f'|format(sp.over)}}%</b> over · <b>{{'%.0f'|format(sp.around)}}%</b> around <span>of {{sp.n}} line-breaking pass{{'es' if sp.n != 1 else ''}} (tracking){% if sp.n < 5 %} · <i>small sample, read with caution</i>{% endif %}</span>{% else %}<b>{{sp.successful}}/{{sp.total}}</b> completed ({{'%.0f'|format(sp.completion_pct)}}%) · <b>{{'%.2f'|format(sp.threat)}}</b> pXT <span>(no tracking: line-break style not available)</span>{% endif %}</div></div>{% endfor %}</div><div class="entlegend" style="padding:0">Entries: <span class="ent-arrow" style="color:#5c7a4a">➜</span> Pass<span class="sep">|</span><span class="ent-arrow" style="color:#c0892d">➜</span> Carry<span class="sep">|</span><span class="ent-arrow" style="color:#a8685f">➜</span> Lost<span class="sep">|</span> Thickness = <b>threat gained</b><span class="sep">|</span> Attacking left to right</div><div class="p9bot">{% for team in team_order %}{% set g=entry_givers_ctx[team] %}<div class="card">{{panel(team.upper()+' · WHO GOT THE BALL THERE','completed entries by the passer or carrier · everyone with 1+')}}<img class="chart" src="{{g.img}}"></div>{% endfor %}</div>{{footer('ip_entries')}}</section>
<section class="sheet">{{mast('In Possession',label('ip_shots'))}}<div class="p10top">{% for s in sides %}<div class="card"><h2>{{s.team}} Shot Map</h2><img class="chart" src="{{s.shot_map}}"><div class="kpis" style="grid-template-columns:repeat(4,1fr);text-align:center"><div><b style="font-size:12pt;display:block;color:#1a1a18">{{s.shot_summary.shots}}</b><span class="muted">Shots</span></div><div><b style="font-size:12pt;display:block;color:#1a1a18">{{s.shot_summary.on_target}}</b><span class="muted">On target</span></div><div><b style="font-size:12pt;display:block;color:#1a1a18">{{'%.2f'|format(s.shot_summary.xg)}}</b><span class="muted">npxG</span></div><div><b style="font-size:12pt;display:block;color:#1a1a18">{{'%.2f'|format(s.shot_summary.xg_per_shot)}}</b><span class="muted">npxG/shot</span></div></div><div style="display:flex;justify-content:space-between;padding-top:1mm;font-size:6pt;color:#6f6a5d"><span>● Goal</span><span>● On</span><span>○ Off</span><span>□ Blocked</span></div></div>{% endfor %}<div class="card"><h2>Chance Source</h2><img class="chart" src="{{chance_source_img}}"><div class="csrclegend"><span><i style="background:#C0892D"></i>Set Piece</span><span><i style="background:#6D3F83"></i>Transition</span><span><i style="background:#5c7a4a"></i>Open Play</span><span><i style="background:#a39d8f"></i>Second Ball</span></div><div class="csummary"><div><b style="color:#d01012">{{chance_source_kpis.charlton_top_source}}</b><span class="muted">{{subject}} top source</span></div><div><b>{{chance_source_kpis.charlton_total}}</b><span class="muted">{{subject}} total npxG</span></div><div><b style="color:#6f6a5d">{{chance_source_kpis.opponent_top_source}}</b><span class="muted">{{opponent}} top source</span></div><div><b>{{chance_source_kpis.opponent_total}}</b><span class="muted">{{opponent}} total npxG</span></div></div></div></div><div class="p10bottom">{% for team in team_order %}<div class="card"><h2>Biggest Chances · {{team}}</h2><table class="table">{% for c in big_chances[team] %}<tr class="{{'goalrow' if c.result=='GOAL' else ''}}"><td>{{c.minute}}</td><td>{{c.player}}</td><td>{{'%.2f'|format(c.xg)}} xG</td><td>{{c.result}}{{' ⚽' if c.result=='GOAL' else ''}}</td></tr>{% endfor %}</table></div>{% endfor %}</div>{{footer('ip_shots')}}</section>
{{divider('out_of_possession','div_oop')}}
<section class="sheet">{{mast('Out of Possession',label('oop_pressure'))}}<div class="grid2 p12"><div class="card">{{panel('Pressure Activity',pressure_kpis.pressure_n|string+' pressures')}}<img class="chart" src="{{pressure_img}}"><div class="kpis2"><div class="kpi2"><b>{{pressure_kpis.forced_pct}}%</b><span>Forced turnover rate</span></div><div class="kpi2"><b>{{pressure_kpis.opp_third_n}}</b><span>Opposition-third pressures</span></div><div class="kpi2"><b>{{pressure_kpis.per_min}}</b><span>Pressures / min</span></div><div class="kpi2"><b class="name">{{pressure_kpis.top_name}}</b><span>Top presser · {{pressure_kpis.top_n}}</span></div></div></div><div class="card">{{panel(subject+' Duel Performance','location, type and outcome')}}<div class="grid2"><div style="text-align:center"><h3>Aerial</h3><div class="muted">{{duel_split_kpis.aerial_pct}}%</div><img class="chart" src="{{aerial_duel_img}}"></div><div style="text-align:center"><h3>Ground</h3><div class="muted">{{duel_split_kpis.ground_pct}}%</div><img class="chart" src="{{ground_duel_img}}"></div></div><div class="mostinvolved"><b>Most involved:</b> {{duel_split_kpis.most_involved}}</div><div class="duellegend"><span>● Won</span><span>✕ Lost</span></div></div></div>{{footer('oop_pressure')}}</section>
<section class="sheet">{{header('Player Duel Performance','Out of Possession',label('oop_duels'),'top five by involvement · both teams')}}<div class="stack2"><div class="card"><div class="duelrow"><span class="vlabel">Aerial Duels</span><img class="widechart" src="{{duel_aerial_bars_img}}"></div></div><div class="card"><div class="duelrow"><span class="vlabel">Ground Duels</span><img class="widechart" src="{{duel_ground_bars_img}}"></div></div></div>{{footer('oop_duels')}}</section>
<section class="sheet">{{mast('Out of Possession',label('oop_regains'))}}<div class="grid2 p14"><div class="stack2"><div class="card">{{panel('Opposition-Half Regains', regain_kpis.n|string+' · avg '+regain_kpis.baseline_avg|string+' · Δ '+regain_kpis.baseline_delta|string+' (n='+regain_kpis.baseline_n|string+')')}}<div class="statline"><b>{{regain_kpis.shot_pct}}%</b><span>of {{regain_kpis.n}} regains led to a shot within 15s ({{regain_kpis.shot_n}} of {{regain_kpis.n}})</span></div><img class="chart" src="{{regain_img}}"></div><div class="card">{{panel('Player Recoveries','opposition-half regains · top 6 by count')}}<img class="chart" src="{{recovery_player_img}}"></div></div><div class="card">{{panel('Second-Ball Wins', second_ball_kpis.won_n|string+' of '+second_ball_kpis.n|string+' · avg '+second_ball_kpis.baseline_avg|string+' · Δ '+second_ball_kpis.baseline_delta|string+' (n='+second_ball_kpis.baseline_n|string+')')}}<div class="statline"><b>{{second_ball_kpis.won_pct}}%</b><span>of {{second_ball_kpis.n}} second-ball contests won ({{second_ball_kpis.won_n}} of {{second_ball_kpis.n}})</span></div><img class="chart" src="{{second_ball_img}}"></div></div>{{footer('oop_regains')}}</section>
{{divider('transition','div_trans')}}
<section class="sheet">{{header('Defensive Transition Response','Transition',label('trans_response'),'what happened after '+subject+' lost the ball in the attacking half')}}<div class="card hero"><img class="chart" src="{{transition_img}}"><p class="muted" style="text-align:center;font-style:italic">red circle = high loss · black cross = opposition shot within 15s · green triangle = counter-press regain within 5s</p></div><div style="display:flex;justify-content:space-between;padding:1mm 0;font-size:6pt;color:#6f6a5d"><span>● Loss (attacking half)</span><span>✕ Loss → opponent shot within 15s</span><span>▲ Counter-press regain (within 5s)</span></div><div class="kpis2"><div class="kpi2"><b>{{transition_kpis.high_losses_n}}</b><span>High losses</span></div><div class="kpi2"><b>{{transition_kpis.counterpress_n}}</b><span>Counter-press regains</span></div><div class="kpi2"><b>{{transition_kpis.shot_n}}</b><span>Led to opponent shot</span></div><div class="kpi2"><b>{{transition_kpis.shot_pct}}%</b><span>Loss-to-shot rate</span></div></div>{{footer('trans_response')}}</section>
</body></html>
