<!doctype html><html><head><meta charset="utf-8"><style>
@page{size:A4 landscape;margin:0}*{box-sizing:border-box}body{margin:0;background:#f3eee1;color:#1a1a18;font-family:'Plus Jakarta Sans',Arial,sans-serif}.sheet{width:297mm;height:210mm;padding:9mm 12mm 7mm;page-break-after:always;overflow:hidden;display:flex;flex-direction:column;gap:4mm}.sheet:last-child{page-break-after:auto}.head{height:13mm;border-bottom:1.2px solid #1a1a18;display:flex;align-items:flex-start}.head b{font-size:15pt;text-transform:uppercase;letter-spacing:.05em}.head span{margin-left:auto;color:#6f6a5d;font-size:7pt;text-transform:uppercase}.foot{margin-top:auto;border-top:.6px solid #cfc7b4;padding-top:1.5mm;display:flex;justify-content:space-between;color:#6f6a5d;font-size:6.5pt}.title{justify-content:center;align-items:center;text-align:center}.title .num{font:italic 800 48pt Georgia;color:#d01012}.title h1{font-size:29pt;letter-spacing:.14em;text-transform:uppercase;margin:2mm}.title p{font:italic 12pt Georgia;color:#6f6a5d;max-width:165mm}.grid2{display:grid;grid-template-columns:1fr 1fr;gap:4mm;min-height:0;flex:1}.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:4mm;min-height:0;flex:1}.card{border:.7px solid #cfc7b4;background:#efe8d8;padding:3mm;display:flex;flex-direction:column;min-height:0;overflow:hidden}.card h2{font-size:9pt;text-transform:uppercase;letter-spacing:.08em;margin:0 0 2mm;border-bottom:.5px solid #cfc7b4;padding-bottom:1.5mm}.card h3{font-size:8pt;margin:0 0 1mm;text-transform:uppercase}.chart{width:100%;height:100%;object-fit:contain;min-height:0}.score{font-size:24pt;font-weight:800}.muted{color:#6f6a5d;font-size:7pt}.stats{font-size:8pt}.stat{display:grid;grid-template-columns:1fr 18mm 18mm;gap:3mm;border-bottom:.4px solid #ded6c4;padding:1.1mm}.stat b{text-align:right}.kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:3mm}.kpi{border-top:2px solid #d01012;padding:3mm;background:#efe8d8}.kpi b{font-size:22pt;color:#d01012;display:block}.kpi span{font-size:7pt;text-transform:uppercase}.hero{flex:1;min-height:0}.hero img{width:100%;height:100%;object-fit:contain}.support{height:48mm}.table{width:100%;border-collapse:collapse;font-size:7pt}.table td,.table th{padding:1.2mm;border-bottom:.4px solid #ded6c4;text-align:right}.table td:first-child,.table th:first-child{text-align:left}.red{color:#d01012}.grey{color:#7d7869}
</style></head><body>
{% macro header(name,n) %}<div class="head"><b>{{name}}</b><span>{{meta.home_team}} v {{meta.away_team}} · {{meta.date}} · {{n}} / 16</span></div>{% endmacro %}
{% macro footer(n) %}<div class="foot"><span>Data: {{source_summary}}</span><span>Post-Match Analyst Report · {{n}}</span></div>{% endmacro %}
<section class="sheet title"><div class="num">01</div><h1>Overview</h1><p>The result, match statistics, territory and the rhythm of the game.</p>{{footer(1)}}</section>
<section class="sheet">{{header('Match Overview',2)}}<div class="grid2"><div class="card"><div class="score">{{sides[0].team}} {{sides[0].goals}}–{{sides[1].goals}} {{sides[1].team}}</div><p class="muted">{{meta.competition}} · {{meta.season}} · {{meta.date_long}}</p><h2>Match statistics</h2><div class="stats">{% for r in stat_rows %}<div class="stat"><span>{{r.label}}</span><b>{{r.home}}</b><b>{{r.away}}</b></div>{% endfor %}</div></div><div class="card"><h2>Chance Sources</h2><img class="chart" src="{{chance_source_img}}"></div></div>{{footer(2)}}</section>
<section class="sheet">{{header('Match Flow',3)}}<div class="grid2"><div class="card"><h2>Territory</h2><img class="chart" src="{{territory_img}}"></div><div class="card"><h2>Shot Maps</h2><div class="grid2">{% for s in sides %}<div><h3>{{s.team}}</h3><img class="chart" src="{{s.shot_map}}"></div>{% endfor %}</div></div></div>{{footer(3)}}</section>
<section class="sheet title"><div class="num">02</div><h1>In Possession</h1><p>Structure, progression, threat creation and chance quality.</p>{{footer(4)}}</section>
{% for team in team_order %}<section class="sheet">{{header('Passing Network · '+team,5+loop.index0)}}<div class="card hero"><h2>{{team}} passing network</h2><img class="chart" src="{{network[team]}}"></div>{{footer(5+loop.index0)}}</section>{% endfor %}
{% for phase in ['avg_pos_in','avg_pos_out'] %}<section class="sheet">{{header(('In Possession' if phase=='avg_pos_in' else 'Out of Possession')+' Shape',7+loop.index0)}}<div class="grid2">{% for team in team_order %}<div class="card"><h2>{{team}} · {{'in possession' if phase=='avg_pos_in' else 'out of possession'}}</h2>{% if side_by_team[team][phase] %}<img class="chart" src="{{side_by_team[team][phase]}}">{% else %}<p class="muted">Tracked phase unavailable</p>{% endif %}</div>{% endfor %}</div>{{footer(7+loop.index0)}}</section>{% endfor %}
<section class="sheet">{{header('Threat & Entries',9)}}<div class="grid3">{% for team in team_order %}<div class="card"><h2>{{team}} entries</h2><img class="chart" src="{{side_by_team[team].entries}}"></div>{% endfor %}<div class="card"><h2>Player contribution</h2><table class="table"><tr><th>Player</th><th>Pass</th><th>xG</th><th>xT</th></tr>{% for p in contributions %}<tr><td>{{p.name}}</td><td>{{p.passes}}</td><td>{{p.xg}}</td><td>{{p.xt}}</td></tr>{% endfor %}</table></div></div>{{footer(9)}}</section>
<section class="sheet">{{header('Chance Quality',10)}}<div class="grid2">{% for s in sides %}<div class="card"><h2>{{s.team}} · {{s.shot_summary.shots}} shots · {{'%.2f'|format(s.shot_summary.xg) }} xG</h2><img class="chart" src="{{s.shot_map}}"></div>{% endfor %}</div><div class="card support"><h2>Where the chances came from</h2><img class="chart" src="{{chance_source_img}}"></div>{{footer(10)}}</section>
<section class="sheet title"><div class="num">03</div><h1>Out of Possession</h1><p>Pressure, duels, regains and second-ball performance.</p>{{footer(11)}}</section>
<section class="sheet">{{header('Pressure & Duel Locations',12)}}<div class="grid3"><div class="card"><h2>Pressure activity</h2><img class="chart" src="{{pressure_img}}"></div><div class="card"><h2>Ground duels</h2><img class="chart" src="{{ground_duel_img}}"></div><div class="card"><h2>Aerial duels</h2><img class="chart" src="{{aerial_duel_img}}"></div></div>{{footer(12)}}</section>
<section class="sheet">{{header('Player Duel Performance',13)}}<div class="card hero"><h2>Duels won by player</h2><img class="chart" src="{{duel_player_img}}"></div>{{footer(13)}}</section>
<section class="sheet">{{header('Regains & Second Balls',14)}}<div class="grid3"><div class="card"><h2>Regain locations</h2><img class="chart" src="{{regain_img}}"></div><div class="card"><h2>Player recoveries</h2><img class="chart" src="{{recovery_player_img}}"></div><div class="card"><h2>Second-ball locations</h2><img class="chart" src="{{second_ball_img}}"></div></div>{{footer(14)}}</section>
<section class="sheet title"><div class="num">04</div><h1>Transition</h1><p>How the team responded immediately after possession changed.</p>{{footer(15)}}</section>
<section class="sheet">{{header('Defensive Transition Response',16)}}<div class="card hero"><h2>Ball losses and defensive response</h2><img class="chart" src="{{transition_img}}"></div><div class="kpis"><div class="kpi"><b>{{event_counts.losses}}</b><span>Ball losses</span></div><div class="kpi"><b>{{event_counts.regains}}</b><span>Regains</span></div><div class="kpi"><b>{{event_counts.pressures}}</b><span>Pressures</span></div><div class="kpi"><b>{{event_counts.second_balls}}</b><span>Second balls</span></div></div>{{footer(16)}}</section>
</body></html>
