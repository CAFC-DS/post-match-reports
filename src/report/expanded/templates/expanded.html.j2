s:repeat(6,1fr);gap:2mm}.gsp{border-top:3px solid #a39d8f}.gsp-leading{border-top-color:#5c7a4a}.gsp-trailing{border-top-color:#4a4538}.gsph{display:flex;justify-content:space-between;align-items:baseline}.gsph b{font-size:8pt;letter-spacing:.04em;text-transform:uppercase}.gsph span{font:italic 6.4pt Georgia,serif;color:#6f6a5d}.gsgoals{font-size:6.2pt;color:#6f6a5d;min-height:4.4mm;padding:.8mm 0}.gsl{font-size:5.6pt;letter-spacing:.06em;text-transform:uppercase;color:#6f6a5d;margin-top:1.6mm}.gsv{display:flex;justify-content:space-between;font-size:9pt}.gsv .s{color:#d01012}.gsv .o{color:#857f72}.gspair{display:grid;grid-template-columns:1fr 1fr;gap:.3mm;height:2.8mm}.gspair i{display:block;height:100%}.gspair .s{background:#d01012;justify-self:end}.gspair .o{background:#857f72}.gstotals{display:grid;grid-template-columns:repeat(6,1fr);gap:2mm}.gst .gstrow{display:flex;gap:1mm;font-size:7pt;padding:.35mm 0;border-bottom:.3px solid #ded6c4}.gst .gstrow span{flex:1;color:#6f6a5d;font-size:5.8pt;text-transform:uppercase;letter-spacing:.04em}.gst .gstrow .s{color:#d01012}.gst .gstrow .o{color:#857f72}.gsband{width:100%;height:auto;display:block}.gstable{width:100%;border-collapse:collapse;font-size:8.4pt}.gstable th{font-size:6pt;text-transform:uppercase;letter-spacing:.05em;color:#6f6a5d;text-align:right;border-bottom:1px solid #1a1a18;padding:.6mm 1.2mm}.gstable th:first-child{text-align:left}.gstable tr th:first-child{font-size:8.4pt;text-transform:none;letter-spacing:0;color:#1a1a18;font-weight:700}.gstable tr:first-child th:first-child{font-size:6pt}.gstable td{text-align:right;padding:1.3mm 1.2mm;border-bottom:.35px solid #ded6c4}.gstable td b{font-weight:800}.gsdiv td{padding:.3mm;border-bottom:1px solid #1a1a18}.sw{display:inline-block;width:2.4mm;height:2.4mm;margin-right:1.6mm;border-radius:.4mm}.sw-leading{background:#d01012}.sw-level{background:#a39d8f}.sw-trailing{background:#4a4538}.sumbanner{display:grid;grid-template-columns:1fr auto 1fr;gap:6mm;align-items:center;padding:4mm 6mm}.sb-team .tn{font-size:12pt;font-weight:800;text-transform:uppercase;letter-spacing:.06em}.sb-team.cha .tn{color:#d01012}.sb-team.opp .tn{color:#7d7869}.sb-team ul{list-style:none;margin:1.5mm 0 0;padding:0;font-size:8.4pt;line-height:1.6;color:#1a1a18}.sb-team.right{text-align:right}.sb-score{text-align:center;font-size:40pt;font-weight:800;line-height:1}.sb-score i{font-style:normal;color:#96907d;margin:0 3mm}.sb-score .cha{color:#d01012}.sb-score .opp{color:#7d7869}.sb-score .ht{font-size:7pt;letter-spacing:.1em;text-transform:uppercase;color:#6f6a5d;margin-top:2mm;font-weight:700}.sumgrid{display:grid;grid-template-columns:1fr 1fr;gap:3mm;flex:1;min-height:0}.sumlist{margin:1mm 0 0;padding-left:4.2mm;font-size:9pt;line-height:1.5}.sumlist li{margin-bottom:1.4mm}.sumtable{width:100%;border-collapse:collapse;font-size:11pt}.sumtable td,.sumtable th{padding:1.9mm 2mm;border-bottom:.35px solid #ded6c4}.sumtable th{font-size:7pt;text-transform:uppercase;letter-spacing:.05em;color:#6f6a5d;text-align:center;font-weight:700}.sumtable td.s{text-align:right;font-weight:800;color:#d01012;width:30%}.sumtable td.o{text-align:left;font-weight:800;color:#7d7869;width:30%}.sumhead{font-size:6.4pt;text-transform:uppercase;letter-spacing:.08em;font-weight:800;margin-top:1.5mm}.sumhead.up{color:#4f6b3e}.sumhead.down{color:#a8433a}.p9tm{display:grid;grid-template-columns:1fr 1fr;gap:2mm}.p9bot{display:grid;grid-template-columns:1fr 1fr;gap:2mm;flex:1;min-height:0}.flow{grid-template-rows:1.2fr 1fr}.flow:has(.tlcard){grid-template-rows:1.2fr 1fr .9fr}.tlimg{width:100%;height:auto;display:block}.tlcard{flex:0 0 auto}.tline{display:flex;gap:2.5mm;align-items:baseline;font-size:7.4pt;line-height:1.35;padding:.4mm 0 1.6mm}.tline .sc{font-size:20pt;font-weight:800;line-height:1}.tline.cha .sc{color:#d01012}.tline.opp .sc{color:#7d7869}.tline i{font-style:normal;color:#6f6a5d}
</style></head><body>
{% macro mast(section,page_str) %}<div class="mast"><div class="brand">CAFC <i>Analyst</i> REPORT</div><div class="fixture">{% for s in sides %}{% if s.badge %}<img src="{{s.badge}}">{% endif %}<span class="{{'red' if s.is_charlton else 'grey'}}">{{s.team}}</span>{% if loop.first %}<strong>{{s.goals}} - {{sides[1].goals}}</strong>{% endif %}{% endfor %}</div><div class="folio">{{meta.date}} · {{meta.competition}}<br>{{section}}{% if page_str %} · {{page_str}}{% endif %}</div></div>{% endmacro %}
{% macro header(name,section,page_str,caption='') %}{{mast(section,page_str)}}<div class="head"><b>{{name}}</b><span>{{caption}}</span></div>{% endmacro %}
{% macro panel(name,caption='') %}<div class="panelhead"><b>{{name}}</b><span>{{caption}}</span></div>{% endmacro %}
{% macro footer(key) %}<div class="foot">{{page_plan.pages[key].n}}/{{page_plan.total}}</div>{% endmacro %}
{% macro label(key) %}{{page_plan.pages[key].label}}{% endmacro %}
{% macro divider(section,key) %}{% set sec=section_info[section] %}<section class="sheet title">{{mast(sec.title,label(key))}}<div class="titlebody"><div class="num">{{sec.num}}</div><h1>{{sec.title}}</h1><hr><p>{{sec.blurb}}</p><div class="contents">{% for it in sec['items'] %}<span>{{it}}</span>{% if not loop.last %}<br>{% endif %}{% endfor %}</div></div>{{footer(key)}}</section>{% endmacro %}
<section class="sheet">{{mast('Contents',label('contents'))}}<div class="tochead"><b>Contents</b><span>what's in this report and where to find it</span></div><div class="toc">{% for r in contents %}<div class="toc-row"><div class="toc-num">{{r.num}}</div><div class="toc-main"><div class="toc-title"><b>{{r.title}}</b><span>{{r.pages}}</span></div><p>{{r.blurb}}</p><div class="toc-items">{% for it in r['items'] %}<span>{{it}}</span>{% endfor %}</div></div></div>{% endfor %}</div>{{footer('contents')}}</section>
{{divider('overview','div_overview')}}
<section class="sheet">{{header('Match Summary','Overview',label('ov_summary'),'the match in plain numbers · '+meta.date+' · '+meta.competition)}}{% set sm=summary %}{% set home=sm.home %}{% set away=(opponent if home==subject else subject) %}<div class="card sumbanner"><div class="sb-team {{'cha' if home==subject else 'opp'}}"><div class="tn">{{home}}</div><ul>{% for g in sm.scorers[home] %}<li><b>{{g.minute}}</b> {{g.who}}</li>{% endfor %}</ul></div><div class="sb-score"><span class="{{'cha' if home==subject else 'opp'}}">{{sm.score[home]}}</span><i>–</i><span class="{{'cha' if away==subject else 'opp'}}">{{sm.score[away]}}</span><div class="ht">Half-time {{sm.half_time[home]}} – {{sm.half_time[away]}}</div></div><div class="sb-team right {{'cha' if away==subject else 'opp'}}"><div class="tn">{{away}}</div><ul>{% for g in sm.scorers[away] %}<li>{{g.who}} <b>{{g.minute}}</b></li>{% endfor %}</ul></div></div><div class="sumgrid"><div class="card">{{panel('How the game went','')}}<ul class="sumlist">{% for l in sm.went %}<li>{{l}}</li>{% endfor %}</ul></div><div class="card">{{panel('Key numbers',subject+' · '+opponent)}}<table class="sumtable">{% for r in sm.numbers %}<tr><td class="s">{{r.subject}}</td><th>{{r.label}}</th><td class="o">{{r.opponent}}</td></tr>{% endfor %}</table></div><div class="card">{{panel('Against '+subject+'\'s season average','furthest above and below the average over '+(baseline_matches|string if baseline_matches else 'the season')+' matches in 25/26')}}<div class="sumhead up">Above the average</div><ul class="sumlist">{% for l in sm.season.above %}<li>{{l}}</li>{% endfor %}</ul><div class="sumhead down">Below the average</div><ul class="sumlist">{% for l in sm.season.below %}<li>{{l}}</li>{% endfor %}</ul></div><div class="card">{{panel('Standout performers','better than both averages in the largest share of measures')}}{% if sm.standouts %}<ul class="sumlist">{% for p in sm.standouts %}<li><b>{{p.name}}</b> ({{p.position}}, {{p.minutes}} minutes) · better than both averages in {{p.ups}} of {{p.rated}} measures{% if p.best %}: {{p.best|join(' · ')}}{% endif %}</li>{% endfor %}</ul>{% else %}<div class="muted">Player averages are not available for this match.</div>{% endif %}</div></div>{{footer('ov_summary')}}</section>
{% if team_sheets %}<section class="sheet">{{header('Team Sheet, Lineups & Timeline','Overview',label('ov_sheet'),'starters, substitutes, goals, cards and substitutions · half-time '~team_sheets[0].ht~' – '~team_sheets[1].ht)}}<div class="card tlcard">{{panel('Match Timeline','goals, cards and substitutions · '+subject+' above the line, '+opponent+' below')}}<img class="tlimg" src="{{timeline_img}}"></div><div class="sheetgrid">{% for t in team_sheets %}<div class="card">{{panel(t.name.upper(),'formation '~t.formation~' · roles as tagged by Impect')}}<div class="tline {{'cha' if t.is_charlton else 'opp'}}"><span class="sc">{{t.score}}</span><span class="gl">{% for g in t.goals %}<b>{{g.min}}</b> {{g.who}}{% if g.assist %} <i>(assist {{g.assist}})</i>{% endif %}{% if not loop.last %} · {% endif %}{% endfor %}</span></div><div class="sheetbody">{% if t.lineup_img %}<img class="lineupimg" src="{{t.lineup_img}}">{% endif %}<table class="sheettable"><tr><th>#</th><th>Player</th><th>Pos</th><th>Min</th><th>Events</th></tr>{% for grp in [t.starters,t.subs] %}{% if loop.index0==1 %}<tr class="subhead"><td colspan="5">Substitutes used</td></tr>{% endif %}{% for r in grp %}<tr><td class="n">{{r.shirt}}</td><td>{{r.name}}</td><td class="pos">{{r.role}}</td><td class="min">{{r.minutes}}'</td><td>{% for m in r.marks %}<span class="mk {{m.kind}}">{{ {'goal':'●','assist':'○','yellow':'▮','red':'▮','on':'▲','off':'▼'}[m.kind] }}{{m.text}}</span>{% endfor %}</td></tr>{% endfor %}{% endfor %}</table></div><div class="unused">● goal · ○ assist · <span style="color:#c0892d">▮</span> yellow · <span style="color:#a00d0f">▮</span> red · ▲ on · ▼ off{% if t.unused %} · Unused substitutes: {{t.unused_names|join(', ')}}{% endif %}</div></div>{% endfor %}</div>{{footer('ov_sheet')}}</section>{% endif %}
<section class="sheet">{{header('Match Stats & Team Performance','Overview',label('ov_stats'),'Baseline: compared to 25/26 averages')}}<div class="statsgrid"><div class="card"><h2>Match Stats</h2><div class="stats"><div class="statshead"><span></span><b>{{meta.home_team.upper()}}</b><span></span><b class="away">{{meta.away_team.upper()}}</b><b>CAFC BASELINE</b></div>{% for r in stat_rows_expanded %}{% if r.group %}<div class="stat-group">{{r.group}}</div>{% endif %}<div class="stat"><span>{{r.label}}</span><b class="{{'cha' if r.home_is_charlton else 'opp'}} {{'hw' if r.home_wins else ''}}">{{r.home}}</b><div class="statbar"><i class="{{'cha' if r.home_is_charlton else 'opp'}}" style="width:{{r.home_share}}%"></i><i class="{{'opp' if r.home_is_charlton else 'cha'}}" style="width:{{r.away_share}}%"></i></div><b class="away {{'opp' if r.home_is_charlton else 'cha'}} {{'hw' if r.away_wins else ''}}">{{r.away}}</b><b class="bl {{r.shade or ''}}">{{r.baseline}}</b></div>{% endfor %}</div></div><div class="statsright"><div class="card wheelcard"><h2>Team Performance</h2><img class="wheelimg" src="{{performance_img}}"></div><div class="card flowcard">{{panel('Match Flow & Territory',('rolling 3-min mean tracked ball position' if territory_is_tracked else 'rolling five-minute net packing xT · IMPECT event data')+' — red = '+subject+"'s attacking half, grey = "+opponent+"'s")}}<img class="flowimg" src="{{flow_timeline_img}}"></div><div class="card flowcard">{{panel('xG Race','cumulative non-penalty xG, goals marked')}}<img class="flowimg" src="{{xg_race_img}}"></div></div></div>{{footer('ov_stats')}}</section>
{% if not team_sheets %}<section class="sheet">{{mast('Overview',label('ov_flow'))}}<div class="flow"><div class="card tlcard">{{panel('Match Timeline','goals, cards and substitutions · '+subject+' above the line, '+opponent+' below')}}<img class="tlimg" src="{{timeline_img}}"></div></div>{{footer('ov_flow')}}</section>{% endif %}
<section class="sheet">{{header('Game State & Phases','Overview',label('ov_phases'),subject+' leading, level or trailing · every 15 minutes of the match for both teams · red = '+subject+', grey = '+opponent)}}<div class="card gscard">{{panel('Game state','the score from '+subject+'\'s side, minute by minute · goals marked')}}<img class="gsband" src="{{gamestate_band_img}}"></div>{% macro gspair(a,b,mx,fa,fb) %}<div class="gsm"><div class="gsv"><b class="s">{{fa}}</b><b class="o">{{fb}}</b></div><div class="gspair"><i class="s" style="width:{{(a/mx*100)|round(0) if mx else 0}}%"></i><i class="o" style="width:{{(b/mx*100)|round(0) if mx else 0}}%"></i></div></div>{% endmacro %}<div class="gsperiods">{% for p in gamestate_data.periods %}<div class="card gsp gsp-{{p.state}}"><div class="gsph"><b>{{p.label}}</b><span>{{p.state_label}}</span></div><div class="gsgoals">{{p.goals|join(' · ') if p.goals else '&nbsp;'|safe}}</div><div class="gsl">xG</div>{{gspair(p.xg[0],p.xg[1],gamestate_scales.xg,'%.2f'|format(p.xg[0]),'%.2f'|format(p.xg[1]))}}<div class="gsl">Share of passes</div>{{gspair(p.possession[0],p.possession[1],100,p.possession[0]~'%',p.possession[1]~'%')}}<div class="gsl">Pressures</div>{{gspair(p.pressures[0],p.pressures[1],gamestate_scales.pressures,p.pressures[0],p.pressures[1])}}<div class="gsl">Shots</div>{{gspair(p.shots[0],p.shots[1],gamestate_scales.shots,p.shots[0],p.shots[1])}}</div>{% endfor %}</div><div class="gstotals">{% for r in gamestate.states + gamestate.other %}<div class="card gst"><div class="gsph"><b>{{r.label|replace('the first substitution','1st sub')}}{{'*' if r.small else ''}}</b><span>{{'%.0f'|format(r.minutes)}} min</span></div><div class="gstrow"><span>xG</span><b class="s">{{'%.2f'|format(r.xg_for)}}</b> – <b class="o">{{'%.2f'|format(r.xg_against)}}</b></div><div class="gstrow"><span>Shots</span><b>{{r.shots_for}}</b> – <b>{{r.shots_against}}</b></div><div class="gstrow"><span>Possession</span><b>{{r.possession if r.possession is not none else '–'}}%</b></div><div class="gstrow"><span>Pressures / min</span><b>{{r.pressures_per_min}}</b></div><div class="gstrow"><span>Opp.-half regains</span><b>{{r.regains}}</b></div></div>{% endfor %}</div><div class="muted">xG and shots: {{subject}} – {{opponent}} · possession = share of passes · pressures and regains are {{subject}}'s · * = under 10 minutes, read with caution · bars share one scale across the six periods</div>{{footer('ov_phases')}}</section>
{{divider('in_possession','div_ip')}}
<section class="sheet">{{header('Passing Networks & Progression','In Possession',label('net'),'starting XI · shared match scales · progression by packing-zone role')}}<div class="net4">{% for team in team_order %}{% set kp=progression_kpis[team] %}<div class="card">{{panel(team.upper()+' · PASSING NETWORK','starting XI · node = pass volume, colour = passing threat')}}<img class="chart" src="{{network[team]}}"></div><div class="card">{{panel(team.upper()+' · PROGRESSION',kp.total|string+' opponents ('+kp.defenders|string+' defenders) bypassed by '+kp.actions|string+' passes & carries')}}<img class="chart" src="{{progression_img[team]}}"></div>{% endfor %}</div><div class="netlegend"><span class="lg-size"><i></i><i></i><i></i> Node Size = Pass Volume</span><span class="lg-grad">Node Colour = Passing Threat <b>−{{network_scale_threat}}</b><span class="lg-bar"></span><b>+{{network_scale_threat}}</b></span><span class="lg-width"><i></i> Link Width = Pass Volume</span><span class="lg-grad">Link Colour = Pair Passing Threat<span class="lg-bar"></span></span><span>Purple = Lost · Green = Gained</span></div><div class="muted" style="text-align:center">Progression: large number = opponents bypassed, small = defenders bypassed, by passes and carries that reached that role. The zone is the role of the player the ball reached, not where the opponents stood (a keeper-to-def-mid pass that skips two forwards counts 2 under 'Def. mid') · own goal on the left · same scale for both teams</div>{{footer('net')}}</section>
{% if tracked_shapes %}{% for team in team_order %}<section class="sheet">{{mast('In Possession',label('shapes_'~loop.index0))}}<div class="grid2">{% for phase in ['avg_pos_in','avg_pos_out'] %}<div class="card">{{panel(team.upper(),'starting XI · attacking upwards')}}<div class="phaselabel">{{'IN POSSESSION' if phase=='avg_pos_in' else 'OUT OF POSSESSION'}}</div><img class="chart" src="{{side_by_team[team][phase]}}">{% set lh = side_by_team[team][phase+'_lh'] %}{% if lh %}<div class="lhcaption">Defensive Line Height: {{'%.0f'|format(lh)}}m</div>{% endif %}</div>{% endfor %}</div>{{footer('shapes_'~loop.index0)}}</section>{% endfor %}{% else %}<section class="sheet">{{mast('In Possession',label('shapes'))}}<div class="grid2">{% for team in team_order %}<div class="card">{{panel(team.upper(),'starting XI · attacking left to right')}}<div class="phaselabel">IN POSSESSION · IMPECT EVENT DATA</div><img class="chart" src="{{side_by_team[team].avg_pos_in}}">{% if side_by_team[team].avg_pos_in_lh %}<div class="lhcaption">Event-derived back-line estimate: {{'%.0f'|format(side_by_team[team].avg_pos_in_lh)}}m</div>{% endif %}<div class="muted" style="text-align:center">Mean location of each starter's IMPECT-tagged in-possession actions; event locations, not tracking.</div></div>{% endfor %}</div>{{footer('shapes')}}</section>{% endif %}
<section class="sheet">{{header('Where Players Received The Ball','In Possession',label('ip_receptions'),'by the packing-zone role of the receiver · as tagged by Impect · build-up receptions and headers left out')}}<div class="grid2">{% for team in team_order %}{% set rc=reception_ctx[team] %}<div class="reccol"><div class="card">{{panel(team.upper(),rc.total|string+' receptions · '+rc.bypassed|string+' opponents bypassed')}}<img class="chart recimg" src="{{rc.img}}"><div class="muted" style="padding-top:1mm">large number = opponents bypassed on receiving, small = receptions · own goal on the left · same scale for both teams</div></div><div class="card">{{panel(team.upper()+' · WHO RECEIVED IT','top '+rc.players|length|string+' receivers by opponents bypassed · balls received by location')}}<table class="rectable"><tr><th>Who received it</th>{% for c in rc.categories %}<th>{{c.label}}</th>{% endfor %}<th class="b">Opponents bypassed</th></tr>{% for p in rc.players %}<tr><td>{{p.name}}</td>{% for c in rc.categories %}<td>{{p.by_category[c.label] or '·'}}</td>{% endfor %}<td class="b">{{p.bypassed}}</td></tr>{% endfor %}<tr class="tot"><td>Team</td>{% for c in rc.categories %}<td>{{c.n}}</td>{% endfor %}<td class="b">{{rc.bypassed}}</td></tr></table></div></div>{% endfor %}</div>{{footer('ip_receptions')}}</section>
<section class="sheet">{{header('Threat Creation & Player Threat','In Possession',label('ip_threat_zones'),'density and role zones above, player threat below · same scale for both teams')}}<div class="p9tm">{% for team in team_order %}{% set td=threat_density_kpis[team] %}{% set tz=threat_zone_kpis[team] %}{% set pt=player_threat_ctx[team] %}<div class="card">{{panel(team.upper(),'threat created (passing + carrying) '+pt.created+' · receiving '+pt.receiving)}}<div class="tmaps"><div><div class="mini">Threat density · {{td.pxt}} positive PXT · {{td.actions}} actions</div><img src="{{threat_density_img[team]}}"></div><div><div class="mini">Threat by role zone · {{tz.total}} xT</div><img src="{{threat_zone_img[team]}}"></div></div></div>{% endfor %}</div><div class="p9bot">{% for team in team_order %}{% set pt=player_threat_ctx[team] %}<div class="card">{{panel(team.upper()+' · PLAYER THREAT','top 8 by passing, carrying and receiving · positive threat, goals excluded')}}<img class="chart" src="{{pt.img}}"></div>{% endfor %}</div><div class="muted" style="text-align:center;padding-top:1mm">Role zones: positive threat of passes and carries by the role they reached (goals and lost passes excluded); zones follow each team's shape, own goal on the left. Player threat: Impect credits a completed move to the passer or carrier and to the receiver, so the three are separate rankings, not shares of one total; passing + carrying is the threat-created measure used elsewhere</div>{{footer('ip_threat_zones')}}</section>
<section class="sheet">{{header('Final Third & Box Entries','In Possession',label('ip_entries'),'route · outcome · destination · who got the ball there')}}<div class="p9c">{% for team in team_order %}{% set sp=side_by_team[team].entries_style_split %}<div class="card">{{panel(team.upper()+' ENTRIES','route · outcome · destination')}}<img class="chart" src="{{side_by_team[team].entries}}"><div class="splitline">{% if line_breaks_available %}<b>{{'%.0f'|format(sp.through)}}%</b> through · <b>{{'%.0f'|format(sp.over)}}%</b> over · <b>{{'%.0f'|format(sp.around)}}%</b> around <span>of {{sp.n}} line-breaking pass{{'es' if sp.n != 1 else ''}} (tracking){% if sp.n < 5 %} · <i>small sample, read with caution</i>{% endif %}</span>{% else %}<b>{{sp.successful}}/{{sp.total}}</b> completed ({{'%.0f'|format(sp.completion_pct)}}%) · <b>{{'%.2f'|format(sp.threat)}}</b> pXT <span>(no tracking: line-break style not available)</span>{% endif %}</div></div>{% endfor %}</div><div class="entlegend" style="padding:0">Entries: <span class="ent-arrow" style="color:#5c7a4a">➜</span> Pass<span class="sep">|</span><span class="ent-arrow" style="color:#c0892d">➜</span> Carry<span class="sep">|</span><span class="ent-arrow" style="color:#a8685f">➜</span> Lost<span class="sep">|</span> Thickness = <b>threat gained</b><span class="sep">|</span> Attacking left to right</div><div class="p9bot">{% for team in team_order %}{% set g=entry_givers_ctx[team] %}<div class="card">{{panel(team.upper()+' · WHO GOT THE BALL THERE','completed entries by the passer or carrier · everyone with 1+')}}<img class="chart" src="{{g.img}}"></div>{% endfor %}</div>{{footer('ip_entries')}}</section>
<section class="sheet">{{mast('In Possession',label('ip_shots'))}}<div class="p10top">{% for s in sides %}<div class="card"><h2>{{s.team}} Shot Map</h2><img class="chart" src="{{s.shot_map}}"><div class="kpis" style="grid-template-columns:repeat(4,1fr);text-align:center"><div><b style="font-size:12pt;display:block;color:#1a1a18">{{s.shot_summary.shots}}</b><span class="muted">Shots</span></div><div><b style="font-size:12pt;display:block;color:#1a1a18">{{s.shot_summary.on_target}}</b><span class="muted">On target</span></div><div><b style="font-size:12pt;display:block;color:#1a1a18">{{'%.2f'|format(s.shot_summary.xg)}}</b><span class="muted">npxG</span></div><div><b style="font-size:12pt;display:block;color:#1a1a18">{{'%.2f'|format(s.shot_summary.xg_per_shot)}}</b><span class="muted">npxG/shot</span></div></div><div style="display:flex;justify-content:space-between;padding-top:1mm;font-size:6pt;color:#6f6a5d"><span>● Goal</span><span>● On</span><span>○ Off</span><span>□ Blocked</span></div></div>{% endfor %}<div class="card"><h2>Chance Source</h2><img class="chart" src="{{chance_source_img}}"><div class="csrclegend"><span><i style="background:#C0892D"></i>Set Piece</span><span><i style="background:#6D3F83"></i>Transition</span><span><i style="background:#5c7a4a"></i>Open Play</span><span><i style="background:#a39d8f"></i>Second Ball</span></div><div class="csummary"><div><b style="color:#d01012">{{chance_source_kpis.charlton_top_source}}</b><span class="muted">{{subject}} top source</span></div><div><b>{{chance_source_kpis.charlton_total}}</b><span class="muted">{{subject}} total npxG</span></div><div><b style="color:#6f6a5d">{{chance_source_kpis.opponent_top_source}}</b><span class="muted">{{opponent}} top source</span></div><div><b>{{chance_source_kpis.opponent_total}}</b><span class="muted">{{opponent}} total npxG</span></div></div></div></div><div class="p10bottom">{% for team in team_order %}{% set pl=placement_ctx[team] %}<div class="card"><h2>Shot Placement &amp; Biggest Chances · {{team}}</h2><div class="plbody"><div class="plchart"><img class="plimg" src="{{placement_img[team]}}"><div class="pllegend"><span>● Goal</span><span>● On target</span><span>○ Off target</span><span>size = xG</span></div><div class="plstat"><b>{{pl.placed}}</b> placed · <b>{{pl.on_target}}</b> on target · <b>{{pl.xgot}}</b> xGOT</div></div><table class="table bctable"><tr><th></th><th></th><th>xG</th><th>xGOT</th><th></th></tr>{% for c in big_chances[team] %}<tr class="{{'goalrow' if c.result=='GOAL' else ''}}"><td>{{c.minute}}</td><td>{{c.player}}</td><td>{{'%.2f'|format(c.xg)}}</td><td>{{'%.2f'|format(c.xgot) if c.xgot is not none else '–'}}</td><td>{{c.result}}{{' ⚽' if c.result=='GOAL' else ''}}</td></tr>{% endfor %}</table></div></div>{% endfor %}</div><div class="muted" style="text-align:center">Shot placement: seen from behind the shooter, posts = goal frame, wide shots pinned to the edge; blocked shots have no target point. xGOT = post-shot xG (Impect), only for shots on target.</div>{{footer('ip_shots')}}</section>
{{divider('out_of_possession','div_oop')}}
<section class="sheet">{{header('Pressing & Duels','Out of Possession',label('oop_pressure'),'pressures and duels in each team\'s own attacking frame · own goal at the bottom · pressure maps on one colour scale')}}<div class="p9tm">{% for team in team_order %}{% set k=pressing_kpis[team] %}{% set dt=duel_totals[team] %}<div class="card">{{panel(team.upper(),k.n|string+' pressures ('+k.forced_pct|string+'% forced a turnover) · '+dt.all.won|string+'/'+dt.all.total|string+' duels won ('+dt.all.pct|string+'%)')}}<div class="mapsrow"><div><h3>Pressure</h3><div class="muted">{{k.n}} pressures</div><img src="{{pressure_heat_img[team]}}"></div><div><h3>Aerial duels</h3><div class="muted">{{dt.AERIAL.won}}/{{dt.AERIAL.total}} won · {{dt.AERIAL.pct}}%</div><img src="{{duel_map_img[team].AERIAL}}"></div><div><h3>Ground duels</h3><div class="muted">{{dt.GROUND.won}}/{{dt.GROUND.total}} won · {{dt.GROUND.pct}}%</div><img src="{{duel_map_img[team].GROUND}}"></div></div><div class="duellegend"><span>● Won</span><span>✕ Lost</span></div></div>{% endfor %}</div><div class="p9bot">{% for team in team_order %}<div class="card">{{panel(team.upper()+' · BEST PRESSERS','top 8 by pressures and forced turnovers · forced turnover = the pressed action failed')}}<img class="chart" src="{{pressing_img[team]}}"></div>{% endfor %}</div>{{footer('oop_pressure')}}</section>
<section class="sheet">{{header('Player Duel Performance','Out of Possession',label('oop_duels'),'top five by involvement · both teams')}}<div class="stack2"><div class="card"><div class="duelrow"><span class="vlabel">Aerial Duels</span><img class="widechart" src="{{duel_aerial_bars_img}}"></div></div><div class="card"><div class="duelrow"><span class="vlabel">Ground Duels</span><img class="widechart" src="{{duel_ground_bars_img}}"></div></div></div>{{footer('oop_duels')}}</section>
<section class="sheet">{{header('Ball Regains','Out of Possession',label('oop_regains'),'where each team won the ball back, by third · own goal at the bottom · ringed = shot within 15s of the regain')}}<div class="p9tm">{% for team in team_order %}{% set r=regain_ctx[team] %}<div class="card">{{panel(team.upper(),r.n|string+' ball regains · '+r.shots|string+' led to a shot within 15s ('+r.shot_pct|string+'%)')}}<div class="presbody"><div class="mapcol"><div class="mini">Regains by third</div><img class="regmap" src="{{regain_img[team]}}"></div><div class="mapcol"><div class="mini">Second balls · ● won ✕ lost</div><img class="regmap" src="{{second_ball_img[team]}}"></div><div class="thirds">{% for name,colour in [('Attacking third','#5c7a4a'),('Middle third','#c0892d'),('Defensive third','#8a8678')] %}{% set idx=2-loop.index0 %}<div class="third" style="border-left:3px solid {{colour}}"><div class="tname">{{name}}</div><div class="tnums"><b>{{r.counts[idx]}}</b><span>{{r.pcts[idx]}}% of regains</span></div><div class="tloss">{{r.losses[idx]}} <span>balls lost here</span></div></div>{% endfor %}{% set sb=second_ball_kpis[team] %}<div class="third" style="border-left:3px solid #1a1a18"><div class="tname">Second-ball contests</div><div class="tnums"><b>{{sb.won_pct}}%</b><span>{{sb.won_n}} of {{sb.n}} won</span></div><div class="tloss">{{sb.n-sb.won_n}} <span>second balls lost</span></div></div></div></div></div>{% endfor %}</div><div class="p9bot">{% for team in team_order %}<div class="card">{{panel(team.upper()+' · WHO WON THE BALL BACK','top 8 by regains · split by the third they won it in')}}<img class="chart" src="{{regain_players_img[team]}}"></div>{% endfor %}</div>{{footer('oop_regains')}}</section>
{{divider('transition','div_trans')}}
{% macro tcard(team,d,mode) %}{% set c=(subject_colour if team==subject else opponent_colour) %}<div class="card tcard" style="border-top:3px solid {{c}}"><h3><b style="color:{{c}}">{{team}}</b><span>{{'after losing the ball' if mode=='def' else 'after winning the ball'}}</span></h3><div class="tkpis">{% for v,l in d.kpis %}<div style="border-left:2.5px solid {{c}}"><b>{{v}}</b><span>{{l}}</span></div>{% endfor %}</div><div class="tbody"><div class="tleft"><img class="tpitch" src="{{d.pitch}}"><div class="tcap">{{'every loss in grey · bubble = loss followed by an opponent shot within 15 s, sized by xG · numbers = the five costliest' if mode=='def' else 'every ball won in grey · bubble = win followed by a shot within 15 s, sized by xG · numbers = the five best'}}</div></div><div class="tright"><div class="tmini">{{'Where losses were punished' if mode=='def' else 'Where attacks started'}}</div><img class="tzone" src="{{d.zone}}"><div class="tcap" style="margin-bottom:0">Impect packing zone of the {{'lost' if mode=='def' else 'won'}} ball · number = xG {{'conceded' if mode=='def' else 'created'}}</div>{% if mode=='def' %}<div class="tmini">How quickly the ball was won back</div><div class="tstack">{% for b in d.buckets %}<div style="width:{{b.pct}}%;background:{{['#3f6b34','#7a9a63','#c0892d','#b9a77a','#8a8678'][loop.index0]}}">{{b.pct if b.pct>=7 else ''}}</div>{% endfor %}</div><div class="tlegend">{% for b in d.buckets %}<span><i style="background:{{['#3f6b34','#7a9a63','#c0892d','#b9a77a','#8a8678'][loop.index0]}}"></i>{{b.label}} {{b.n}}</span>{% endfor %}</div><div class="tmini">Counter-press · who won it back within 5 s</div>{% for p in d.counterpress[:5] %}<div class="tbar"><span>{{p.name}}</span><i style="width:{{(p.n/d.counterpress[0].n*100)|round(0)}}%;background:{{c}}"></i><b>{{p.n}}</b></div>{% endfor %}{% else %}<div class="tmini">By third</div><table class="ttable small"><tr><th></th><th>Won</th><th>Shots</th><th class="x">xG</th></tr>{% for r in d.by_third %}<tr><td>{{r.name|replace(' third','')}}</td><td>{{r.wins}}</td><td>{{r.shots}}</td><td class="x"><b>{{'%.2f'|format(r.xg)}}</b></td></tr>{% endfor %}</table><div class="tmini">Who started attacks that ended in a shot</div>{% for p in d.starters[:4] %}<div class="tbar"><span>{{p.name}}</span><i style="width:{{(p.n/d.starters[0].n*100)|round(0)}}%;background:{{c}}"></i><b>{{p.n}}</b></div>{% else %}<div class="tcap">none</div>{% endfor %}{% endif %}</div></div><table class="ttable"><tr><th>#</th><th>Min</th><th>{{'Lost by' if mode=='def' else 'Won by'}}</th><th>Zone</th><th>{{'Won back in' if mode=='def' else 'To the shot'}}</th><th>Shots</th><th class="x">{{'xG conceded' if mode=='def' else 'xG created'}}</th></tr>{% for r in d.rows %}<tr><td class="n">{{r.n}}</td><td>{{r.minute}}</td><td>{{r.player}}</td><td>{{r.zone}}</td><td>{{r.back if mode=='def' else r.to_shot}}</td><td>{{r.shots}}</td><td class="x">{% if r.xg!='–' %}<i style="width:{{(r.xg/d.xg_max*100)|round(0)}}%;background:{{c}}"></i>{% endif %}<b>{{'%.2f'|format(r.xg) if r.xg!='–' else '–'}}</b></td></tr>{% endfor %}</table></div>{% endmacro %}
<section class="sheet">{{header('Defending Transition','Transition',label('trans_defending'),'what each team gave away and won back in the seconds after losing the ball')}}<div class="two tpage">{% for team in team_order %}{{tcard(team,trans_defending[team],'def')}}{% endfor %}</div><div class="muted">A shot counts when it comes within 15 s of the loss and the team that lost the ball has not touched it again · time to regain = seconds to the team's next ball win in the same half (up to 20 s)</div>{{footer('trans_defending')}}</section>
<section class="sheet">{{header('Attacking Transition','Transition',label('trans_attacking'),'what each team made of the moments it won the ball')}}<div class="two tpage">{% for team in team_order %}{{tcard(team,trans_attacking[team],'att')}}{% endfor %}</div><div class="muted">A shot counts when it comes within 15 s of the ball win and the opponent has not touched the ball in between</div>{{footer('trans_attacking')}}</section>
{% if player_pages %}{{divider('players','div_players')}}{% for g in player_pages %}<section class="sheet">{{header('Player Performance · '+g.label,'Player Performances',label('pl_'~g.key),subject+' players only · Today = what he did in this game · Season and League = per 90 minutes, over '+player_baseline_matches|string+' earlier matches (the league figure is the average for his position)')}}<div class="card ptcard">{% if g.columns %}<div class="ptwrap"><table class="pcols {{'dense' if g.columns|length>5 else ''}} {{'tall' if g.rows|length>12 else ''}} {{'' if g.physical else 'fill'}}"><tr><th class="rl" rowspan="2"></th>{% for c in g.columns %}<th colspan="3" class="ph tstart {{'' if c.rated else 'unr'}}">{% if g.key!='midfielders' %}<em class="role">{{c.role}}</em>{% endif %}<span class="sh">{{c.shirt}}</span>{{c.name}}<small>{{c.minutes}} minutes{% if c.played_as %} · played as {{c.played_as|lower}} today{% endif %}</small></th>{% endfor %}</tr><tr>{% for c in g.columns %}<th class="sub tstart">Today</th><th class="sub">Season /90</th><th class="sub">League /90</th>{% endfor %}</tr>{% for r in g.rows %}<tr><th class="rl"><b>{{r.label}}</b>{% if r.desc %}<small>{{r.desc}}</small>{% endif %}</th>{% for c in r.cells %}<td class="val tstart v-{{c.v_both or 'none'}}">{{c.text}}</td><td class="avg a-{{c.v_own or 'none'}}">{{c.own}}</td><td class="avg a-{{c.v_league or 'none'}}">{{c.league}}</td>{% endfor %}</tr>{% endfor %}</table>{% if g.physical %}<table class="pcols phys"><tr><th class="rl"><b>Physical output</b><small>Second Spectrum tracking, whole match</small></th>{% for c in g.columns %}<th colspan="3" class="ph tstart">{{c.name}}</th>{% endfor %}</tr>{% for r in g.physical %}<tr><th class="rl"><b>{{r.label}}</b>{% if r.unit %}<small>{{r.unit}}</small>{% endif %}</th>{% for v in r.cells %}<td colspan="3" class="val tstart">{{v}}</td>{% endfor %}</tr>{% endfor %}</table>{% endif %}</div>{% else %}<div class="muted" style="padding:20mm;text-align:center">No {{g.label|lower}} played for {{subject}} in this match.</div>{% endif %}<div class="ptlegend"><span class="lg v-up">Today better than both averages</span><span class="lg v-mixed">mixed</span><span class="lg v-down">worse than both</span><span class="lg v-level">within 5%</span><span>Colours compare today's rate per 90 with the averages (so a short appearance is judged fairly); Season and League cells are tinted by whether today beats that average · under 20 minutes, or no season average yet = not coloured · ball losses and fouls: lower is better</span></div></div>{{footer('pl_'~g.key)}}</section>{% endfor %}{% endif %}
</body></html>
