<!doctype html><html><head><meta charset="utf-8"><style>{{font_faces_css|safe}}</style><style>
@page{size:A4 landscape;margin:0}*{box-sizing:border-box}body{margin:0;background:#f3eee1;color:#1a1a18;font-family:'Plus Jakarta Sans',system-ui,-apple-system,'Segoe UI',sans-serif}.sheet{width:297mm;height:210mm;padding:9mm 10mm 7mm;page-break-after:always;overflow:hidden;display:flex;flex-direction:column;gap:2.5mm}.sheet:last-child{page-break-after:auto}.mast{height:12mm;border-bottom:1px solid #1a1a18;display:grid;grid-template-columns:1fr auto 1fr;align-items:center}.brand{font-size:8pt;font-weight:800;letter-spacing:.08em}.brand i{color:#d01012}.fixture{display:flex;align-items:center;gap:3mm;font-size:9pt;font-weight:800}.fixture img{width:7mm;height:7mm;object-fit:contain}.fixture strong{font-size:11pt}.folio{text-align:right;color:#6f6a5d;font-size:5.8pt;text-transform:uppercase;line-height:1.45}.head{height:8mm;border-bottom:.7px solid #cfc7b4;display:flex;align-items:center}.head b{font-size:7pt;text-transform:uppercase;letter-spacing:.1em}.head b:before,.card h2:before{content:'■';color:#d01012;font-size:5pt;margin-right:1.5mm}.head span{margin-left:auto;color:#6f6a5d;font-size:6.4pt;font-style:italic;font-family:'Spectral','Iowan Old Style',Georgia,serif}.foot{margin-top:auto;text-align:center;color:#6f6a5d;font-size:5.5pt}.titlebody{flex:1;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center}.title .num{font:italic 800 38pt Georgia;color:#d01012}.title h1{font-size:24pt;letter-spacing:.14em;text-transform:uppercase;margin:1mm}.title hr{width:16mm;height:1.4px;background:#d01012;border:none;margin:2mm auto 4mm}.title p{font:italic 9pt 'Spectral','Iowan Old Style',Georgia,serif;color:#6f6a5d;max-width:165mm}.contents{margin-top:7mm;text-align:left;font-size:6.5pt;font-weight:700;line-height:1.8;text-transform:uppercase}.contents span:before{content:'■';color:#d01012;margin-right:2mm}.grid2{display:grid;grid-template-columns:1fr 1fr;gap:3mm;min-height:0;flex:1}.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:3mm;min-height:0;flex:1}.card{border:.6px solid #cfc7b4;padding:2mm;display:flex;flex-direction:column;min-height:0;overflow:hidden}.card h2{font-size:6.5pt;text-transform:uppercase;letter-spacing:.08em;margin:0 0 1mm;border-bottom:.4px solid #ded6c4;padding-bottom:1mm}.panelhead{display:flex;align-items:baseline;margin:0 0 1mm;border-bottom:.4px solid #ded6c4;padding-bottom:1mm}.panelhead b{font-size:6.5pt;text-transform:uppercase;letter-spacing:.08em;font-weight:800}.panelhead b:before{content:'■';color:#d01012;font-size:5pt;margin-right:1.5mm}.panelhead span{margin-left:auto;color:#6f6a5d;font-size:6.4pt;font-style:italic;font-family:'Spectral','Iowan Old Style',Georgia,serif}.card h3{font-size:6pt;margin:0 0 1mm;text-transform:uppercase}.chart{width:100%;height:100%;object-fit:contain;min-height:0}.score{font-size:17pt;font-weight:800}.muted{color:#6f6a5d;font-size:6pt}.stats{font-size:6pt}.statshead{display:grid;grid-template-columns:34mm 12mm 1fr 12mm 16mm;align-items:end;gap:1.6mm;padding:0 .65mm 1.2mm;border-bottom:1px solid #1a1a18}.statshead b{text-align:right;font-size:4.6pt;font-weight:800;letter-spacing:.03em;color:#6f6a5d;line-height:1.15;white-space:normal}.statshead b.away{text-align:left}.stat{display:grid;grid-template-columns:34mm 12mm 1fr 12mm 16mm;align-items:center;gap:1.6mm;border-bottom:.35px solid #ded6c4;padding:.9mm .65mm}.stat span{font-weight:700}.stat b{text-align:right;font-weight:800;color:#1a1a18}.stat b.away{text-align:left}.stat b.cha{color:#d01012}.stat b.opp{color:#7d7869}.stat b.hw{text-decoration:underline}.stat .bl{text-align:center;color:#918c7a;border-radius:.8mm;padding:.4mm 1mm;font-weight:800}.stat .bl.good{background:#d7e3ce;color:#3f7d4f}.stat .bl.bad{background:#ecd6d1;color:#a8433a}.stat-group{font-size:5.3pt;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:#96907d;margin-top:1.6mm;padding:.8mm .65mm 0}.statbar{height:1.3mm;display:flex;overflow:hidden}.statbar i{display:block;height:100%}.statbar i.cha{background:#d01012}.statbar i.opp{background:#7d7869}.kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:3mm}.kpi{border-top:1.5px solid #d01012;padding:2.2mm 1mm}.kpi b{font-size:15pt;color:#d01012;display:block;line-height:1.15}.kpi span{font-size:5.8pt;text-transform:uppercase;letter-spacing:.04em;color:#6f6a5d;display:block;margin-top:.6mm}.kpis2{display:grid;grid-template-columns:repeat(4,1fr);gap:3mm}.kpi2{border:.6px solid #cfc7b4;border-radius:.8mm;background:#faf7ee;padding:2.6mm 1.2mm;text-align:center}.kpi2 b{font-size:15pt;color:#d01012;display:block;line-height:1.15}.kpi2 b.name{font-size:9pt;overflow-wrap:break-word}.kpi2 span{font-size:5.8pt;text-transform:uppercase;letter-spacing:.04em;color:#6f6a5d;display:block;margin-top:.6mm}.statline{display:flex;align-items:baseline;justify-content:center;text-align:center;gap:2.5mm;padding:1mm 0}.statline b{font-size:20pt;color:#d01012;font-weight:800;white-space:nowrap}.statline span{font-size:6.8pt;color:#6f6a5d;line-height:1.35}.hero{flex:1;min-height:0}.hero img{width:100%;height:100%;object-fit:contain}.support{height:43mm}.table{width:100%;border-collapse:collapse;font-size:8pt}.table td,.table th{padding:2.4mm .8mm;border-bottom:.35px solid #ded6c4;text-align:right}.table td:first-child,.table th:first-child{text-align:left}.table tr.goalrow{background:#f9e6cf}.table tr.goalrow td{font-weight:800;color:#1a1a18}.red{color:#d01012}.grey{color:#7d7869}.p2{grid-template-columns:1.15fr .85fr}.highlights-card{height:31mm}.highlights{flex:1;min-height:0;display:grid;grid-template-columns:repeat(3,1fr);gap:2mm;margin-top:1mm}.hl-item{border-top:3px solid #d01012;border-left:.5px solid #ded6c4;border-right:.5px solid #ded6c4;border-bottom:.5px solid #ded6c4;background:#ece4d0;padding:2.8mm 2.4mm;box-shadow:0 1mm 1.5mm rgba(26,26,24,.08)}.hl-item p{margin:0;font-size:7.4pt;font-weight:800;color:#1a1a18;line-height:1.44}.hl-item p:before{content:'■';color:#d01012;font-size:6pt;margin-right:1.6mm}.flow{display:grid;grid-template-rows:1fr 1fr;gap:2mm;flex:1;min-height:0}.p9{display:grid;grid-template-columns:1fr 1.45fr;grid-template-rows:1fr 55mm;gap:2mm;flex:1;min-height:0}.span2{grid-column:1/3}.p10top{display:grid;grid-template-columns:1fr 1fr .68fr;gap:2mm;height:104mm}.p10bottom{display:grid;grid-template-columns:1fr 1fr;gap:2mm;flex:1}.p12{grid-template-columns:.6fr 1.4fr}.p14{grid-template-columns:1.25fr .75fr}.stack2{display:grid;grid-template-rows:1fr 1fr;gap:2mm;min-height:0}.duelgrid{display:grid;grid-template-columns:1fr 1fr;gap:3mm;flex:1}.widechart{height:100%;width:100%;object-fit:contain}.netlegend{display:flex;align-items:center;justify-content:center;gap:5mm;font-size:6pt;color:#6f6a5d;flex-wrap:wrap;padding-top:1mm}.netlegend b{font-weight:800;color:#1a1a18;font-size:5.6pt}.lg-size,.lg-grad,.lg-width{display:flex;align-items:center;gap:1mm}.lg-size i{display:inline-block;border-radius:50%;background:#7d7869}.lg-size i:nth-child(1){width:2mm;height:2mm}.lg-size i:nth-child(2){width:3mm;height:3mm}.lg-size i:nth-child(3){width:4.2mm;height:4.2mm}.lg-bar{width:14mm;height:1.8mm;border-radius:1mm;background:linear-gradient(to right,#6d3f83,#7d7869,#4f6b3e)}.lg-width i{display:inline-block;width:8mm;height:1.6mm;background:#7d7869;border-radius:1mm}.duelrow{display:flex;align-items:stretch;height:100%;min-height:0}.vlabel{writing-mode:vertical-rl;transform:rotate(180deg);font-size:7pt;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:#1a1a18;display:flex;align-items:center;justify-content:center;padding-right:2mm}.duelrow .widechart{flex:1;min-width:0}.phaselabel{font-size:7pt;font-weight:800;letter-spacing:.08em;color:#d01012;padding:0 .65mm 1mm}.lhcaption{text-align:center;font-size:7pt;color:#6f6a5d;padding-top:.8mm}.threathead{display:flex;justify-content:space-around;padding:0 0 1.2mm;margin-bottom:1mm;border-bottom:.4px solid #ded6c4}.threathead b{font-size:8.5pt;text-transform:uppercase;letter-spacing:.06em}.threathead span{font-size:6.6pt;color:#6f6a5d;font-style:italic;font-family:'Spectral','Iowan Old Style',Georgia,serif;margin-left:2mm}.threathead .cha b{color:#d01012}.threathead .opp b{color:#7d7869}.entlegend{display:flex;align-items:center;justify-content:center;gap:1.6mm;padding-top:1.2mm;font-size:6.4pt;color:#1a1a18}.entlegend b{font-weight:800}.entlegend .ent-arrow{font-weight:800;font-size:7.5pt}.entlegend .sep{color:#cfc7b4;margin:0 .6mm}.csrclegend{display:flex;flex-wrap:wrap;justify-content:center;gap:2.5mm;padding:1mm 0;font-size:6.4pt;color:#1a1a18;font-weight:700}.csrclegend span{display:flex;align-items:center;gap:1mm}.csrclegend i{display:inline-block;width:2.6mm;height:2.6mm;border-radius:.5mm}.csummary{display:grid;grid-template-columns:1fr 1fr;gap:1.5mm;text-align:center;font-size:7.5pt;margin-top:1mm;border-top:.4px solid #ded6c4;padding-top:1.5mm}.csummary div{display:flex;flex-direction:column;gap:.6mm}.csummary b{font-size:9pt}.csummary span{font-size:6.2pt}.mostinvolved{text-align:center;font-size:7pt;padding-top:2mm;border-top:.4px solid #ded6c4}.duellegend{display:flex;justify-content:center;gap:5mm;font-size:6.5pt;color:#6f6a5d;padding-top:1.4mm}
</style></head><body>
{% macro mast(section,page_str) %}<div class="mast"><div class="brand">CAFC <i>Analyst</i> REPORT</div><div class="fixture">{% for s in sides %}{% if s.badge %}<img src="{{s.badge}}">{% endif %}<span class="{{'red' if s.is_charlton else 'grey'}}">{{s.team}}</span>{% if loop.first %}<strong>{{s.goals}} - {{sides[1].goals}}</strong>{% endif %}{% endfor %}</div><div class="folio">{{meta.date}} · {{meta.competition}}<br>{{section}} · {{page_str}}</div></div>{% endmacro %}
{% macro header(name,section,page_str,caption='') %}{{mast(section,page_str)}}<div class="head"><b>{{name}}</b><span>{{caption}}</span></div>{% endmacro %}
{% macro panel(name,caption='') %}<div class="panelhead"><b>{{name}}</b><span>{{caption}}</span></div>{% endmacro %}
{% macro footer(n) %}<div class="foot">{{n}}/{{report_page_count}}</div>{% endmacro %}
<section class="sheet title">{{mast('Overview','DIVIDER')}}<div class="titlebody"><div class="num">1</div><h1>Overview</h1><hr><p>Match stats, {{subject}}'s season-relative performance profile, and how the game unfolded.</p><div class="contents"><span>Match stats & team performance</span><br><span>Match flow & xG race</span></div></div>{{footer(1)}}</section>
<section class="sheet">{{header('Match Stats & Team Performance','Overview','PAGE 1/2','Baseline: compared to 25/26 averages')}}<div class="grid2 p2"><div class="card"><h2>Match Stats</h2><div class="stats"><div class="statshead"><span></span><b>{{meta.home_team.upper()}}</b><span></span><b class="away">{{meta.away_team.upper()}}</b><b>CAFC BASELINE</b></div>{% for r in stat_rows_expanded %}{% if r.group %}<div class="stat-group">{{r.group}}</div>{% endif %}<div class="stat"><span>{{r.label}}</span><b class="{{'cha' if r.home_is_charlton else 'opp'}} {{'hw' if r.home_wins else ''}}">{{r.home}}</b><div class="statbar"><i class="{{'cha' if r.home_is_charlton else 'opp'}}" style="width:{{r.home_share}}%"></i><i class="{{'opp' if r.home_is_charlton else 'cha'}}" style="width:{{r.away_share}}%"></i></div><b class="away {{'opp' if r.home_is_charlton else 'cha'}} {{'hw' if r.away_wins else ''}}">{{r.away}}</b><b class="bl {{r.shade or ''}}">{{r.baseline}}</b></div>{% endfor %}</div></div><div class="card"><h2>Team Performance</h2><img class="chart" src="{{performance_img}}"></div></div><div class="card highlights-card">{{panel('Match Highlights','three takeaways')}}<div class="highlights">{% for text in match_highlights %}<div class="hl-item"><p>{{text}}</p></div>{% endfor %}</div></div>{{footer(2)}}</section>
<section class="sheet">{{mast('Overview','PAGE 2/2')}}<div class="flow"><div class="card">{{panel('Match Flow / Territory',('rolling 3-min mean tracked ball position' if territory_is_tracked else 'rolling five-minute net packing xT · IMPECT event data')+' — red = '+subject+"'s attacking half, grey = "+opponent+"'s")}}<img class="chart" src="{{territory_img}}"></div><div class="card">{{panel('xG Race','cumulative non-penalty xG, goals marked')}}<img class="chart" src="{{xg_race_img}}"></div></div>{{footer(3)}}</section>
<section class="sheet title">{{mast('In Possession','DIVIDER')}}<div class="titlebody"><div class="num">2</div><h1>In Possession</h1><hr><p>How both teams built play, how {{subject}} progressed threat, and how chance quality compared.</p><div class="contents"><span>Separate passing networks</span><br><span>{{'Team-by-team tracked phase shapes' if tracked_shapes else 'Combined event-data average locations'}}</span><br><span>Threat density, entries & player threat</span><br><span>Comparative shot maps & xG sources</span></div></div>{{footer(4)}}</section>
{% for team in team_order %}<section class="sheet">{{header(team.upper()+' PASSING NETWORK','In Possession','PAGE '+loop.index|string+'/'+('6' if tracked_shapes else '5'),'starting XI · shared match scales')}}<div class="card hero"><img class="chart" src="{{network[team]}}"><div class="netlegend"><span class="lg-size"><i></i><i></i><i></i> Node Size = Pass Volume</span><span class="lg-grad">Node Colour = Passing Threat <b>−{{network_scale_threat}}</b><span class="lg-bar"></span><b>+{{network_scale_threat}}</b></span><span class="lg-width"><i></i> Link Width = Pass Volume</span><span class="lg-grad">Link Colour = Pair Passing Threat<span class="lg-bar"></span></span><span>Purple = Lost · Green = Gained</span></div></div>{{footer(5+loop.index0)}}</section>{% endfor %}
{% if tracked_shapes %}{% for team in team_order %}<section class="sheet">{{mast('In Possession','PAGE '+(2+loop.index)|string+'/6')}}<div class="grid2">{% for phase in ['avg_pos_in','avg_pos_out'] %}<div class="card">{{panel(team.upper(),'starting XI · attacking upwards')}}<div class="phaselabel">{{'IN POSSESSION' if phase=='avg_pos_in' else 'OUT OF POSSESSION'}}</div><img class="chart" src="{{side_by_team[team][phase]}}">{% set lh = side_by_team[team][phase+'_lh'] %}{% if lh %}<div class="lhcaption">Defensive Line Height: {{'%.0f'|format(lh)}}m</div>{% endif %}</div>{% endfor %}</div>{{footer(7+loop.index0)}}</section>{% endfor %}{% else %}<section class="sheet">{{mast('In Possession','PAGE 3/5')}}<div class="grid2">{% for team in team_order %}<div class="card">{{panel(team.upper(),'starting XI · attacking left to right')}}<div class="phaselabel">IN POSSESSION · IMPECT EVENT DATA</div><img class="chart" src="{{side_by_team[team].avg_pos_in}}">{% if side_by_team[team].avg_pos_in_lh %}<div class="lhcaption">Event-derived back-line estimate: {{'%.0f'|format(side_by_team[team].avg_pos_in_lh)}}m</div>{% endif %}<div class="muted" style="text-align:center">Mean location of each starter's IMPECT-tagged in-possession actions; event locations, not tracking.</div></div>{% endfor %}</div>{{footer(7)}}</section>{% endif %}
<section class="sheet">{{mast('In Possession','PAGE '+('5/6' if tracked_shapes else '4/5'))}}<div class="p9"><div class="card">{{panel('Threat Density Map','positive PXT Attack · action start')}}<img class="chart" src="{{threat_img}}"><div class="muted" style="text-align:center">{{threat_pxt}} positive PXT Attack · {{threat_actions}} actions</div></div><div class="card">{{panel('Final Third Entries & Box Entries','route · outcome · destination')}}<img class="chart" src="{{side_by_team[subject].entries}}"><div class="entlegend"><span class="ent-arrow" style="color:#5c7a4a">➜</span> Pass<span class="sep">|</span><span class="ent-arrow" style="color:#c0892d">➜</span> Carry<span class="sep">|</span><span class="ent-arrow" style="color:#a8685f">➜</span> Lost<span class="sep">|</span> Thickness = <b>threat gained</b><span class="sep">|</span> Attacking left to right</div></div><div class="card span2">{{panel('Player Threat Ranking','open-play creation · goals excluded · most impactful, both teams')}}<div class="threathead"><div class="cha"><b>{{subject}}</b><span>team total {{player_threat_ranking_totals[subject]}}</span></div><div class="opp"><b>{{opponent}}</b><span>team total {{player_threat_ranking_totals[opponent]}}</span></div></div><img class="chart" src="{{player_threat_ranking_img}}"></div></div>{{footer(9 if tracked_shapes else 8)}}</section>
<section class="sheet">{{mast('In Possession','PAGE '+('6/6' if tracked_shapes else '5/5'))}}<div class="p10top">{% for s in sides %}<div class="card"><h2>{{s.team}} Shot Map</h2><img class="chart" src="{{s.shot_map}}"><div class="kpis" style="grid-template-columns:repeat(4,1fr);text-align:center"><div><b style="font-size:12pt;display:block;color:#1a1a18">{{s.shot_summary.shots}}</b><span class="muted">Shots</span></div><div><b style="font-size:12pt;display:block;color:#1a1a18">{{s.shot_summary.on_target}}</b><span class="muted">On target</span></div><div><b style="font-size:12pt;display:block;color:#1a1a18">{{'%.2f'|format(s.shot_summary.xg)}}</b><span class="muted">npxG</span></div><div><b style="font-size:12pt;display:block;color:#1a1a18">{{'%.2f'|format(s.shot_summary.xg_per_shot)}}</b><span class="muted">npxG/shot</span></div></div><div style="display:flex;justify-content:space-between;padding-top:1mm;font-size:6pt;color:#6f6a5d"><span>● Goal</span><span>● On</span><span>○ Off</span><span>□ Blocked</span></div></div>{% endfor %}<div class="card"><h2>Chance Source</h2><img class="chart" src="{{chance_source_img}}"><div class="csrclegend"><span><i style="background:#C0892D"></i>Set Piece</span><span><i style="background:#6D3F83"></i>Transition</span><span><i style="background:#5c7a4a"></i>Open Play</span><span><i style="background:#a39d8f"></i>Second Ball</span></div><div class="csummary"><div><b style="color:#d01012">{{chance_source_kpis.charlton_top_source}}</b><span class="muted">{{subject}} top source</span></div><div><b>{{chance_source_kpis.charlton_total}}</b><span class="muted">{{subject}} total npxG</span></div><div><b style="color:#6f6a5d">{{chance_source_kpis.opponent_top_source}}</b><span class="muted">{{opponent}} top source</span></div><div><b>{{chance_source_kpis.opponent_total}}</b><span class="muted">{{opponent}} total npxG</span></div></div></div></div><div class="p10bottom">{% for team in team_order %}<div class="card"><h2>Biggest Chances · {{team}}</h2><table class="table">{% for c in big_chances[team] %}<tr class="{{'goalrow' if c.result=='GOAL' else ''}}"><td>{{c.minute}}</td><td>{{c.player}}</td><td>{{'%.2f'|format(c.xg)}} xG</td><td>{{c.result}}{{' ⚽' if c.result=='GOAL' else ''}}</td></tr>{% endfor %}</table></div>{% endfor %}</div>{{footer(10 if tracked_shapes else 9)}}</section>
<section class="sheet title">{{mast('Out of Possession','DIVIDER')}}<div class="titlebody"><div class="num">3</div><h1>Out of Possession</h1><hr><p>Where {{subject}} engaged, competed and recovered the ball.</p><div class="contents"><span>Pressure activity & spatial duel performance</span><br><span>Opposition-half regains & second balls</span></div></div>{{footer(11 if tracked_shapes else 10)}}</section>
<section class="sheet">{{mast('Out of Possession','PAGE 1/3')}}<div class="grid2 p12"><div class="card">{{panel('Pressure Activity',pressure_kpis.pressure_n|string+' pressures')}}<img class="chart" src="{{pressure_img}}"><div class="kpis2"><div class="kpi2"><b>{{pressure_kpis.forced_pct}}%</b><span>Forced turnover rate</span></div><div class="kpi2"><b>{{pressure_kpis.opp_third_n}}</b><span>Opposition-third pressures</span></div><div class="kpi2"><b>{{pressure_kpis.per_min}}</b><span>Pressures / min</span></div><div class="kpi2"><b class="name">{{pressure_kpis.top_name}}</b><span>Top presser · {{pressure_kpis.top_n}}</span></div></div></div><div class="card">{{panel(subject+' Duel Performance','location, type and outcome')}}<div class="grid2"><div style="text-align:center"><h3>Aerial</h3><div class="muted">{{duel_split_kpis.aerial_pct}}%</div><img class="chart" src="{{aerial_duel_img}}"></div><div style="text-align:center"><h3>Ground</h3><div class="muted">{{duel_split_kpis.ground_pct}}%</div><img class="chart" src="{{ground_duel_img}}"></div></div><div class="mostinvolved"><b>Most involved:</b> {{duel_split_kpis.most_involved}}</div><div class="duellegend"><span>● Won</span><span>✕ Lost</span></div></div></div>{{footer(12 if tracked_shapes else 11)}}</section>
<section class="sheet">{{header('Player Duel Performance','Out of Possession','PAGE 2/3','top five by involvement · both teams')}}<div class="stack2"><div class="card"><div class="duelrow"><span class="vlabel">Aerial Duels</span><img class="widechart" src="{{duel_aerial_bars_img}}"></div></div><div class="card"><div class="duelrow"><span class="vlabel">Ground Duels</span><img class="widechart" src="{{duel_ground_bars_img}}"></div></div></div>{{footer(13 if tracked_shapes else 12)}}</section>
<section class="sheet">{{mast('Out of Possession','PAGE 3/3')}}<div class="grid2 p14"><div class="stack2"><div class="card">{{panel('Opposition-Half Regains', regain_kpis.n|string+' · avg '+regain_kpis.baseline_avg|string+' · Δ '+regain_kpis.baseline_delta|string+' (n='+regain_kpis.baseline_n|string+')')}}<div class="statline"><b>{{regain_kpis.shot_pct}}%</b><span>of {{regain_kpis.n}} regains led to a shot within 15s ({{regain_kpis.shot_n}} of {{regain_kpis.n}})</span></div><img class="chart" src="{{regain_img}}"></div><div class="card">{{panel('Player Recoveries','opposition-half regains · top 6 by count')}}<img class="chart" src="{{recovery_player_img}}"></div></div><div class="card">{{panel('Second-Ball Wins', second_ball_kpis.won_n|string+' of '+second_ball_kpis.n|string+' · avg '+second_ball_kpis.baseline_avg|string+' · Δ '+second_ball_kpis.baseline_delta|string+' (n='+second_ball_kpis.baseline_n|string+')')}}<div class="statline"><b>{{second_ball_kpis.won_pct}}%</b><span>of {{second_ball_kpis.n}} second-ball contests won ({{second_ball_kpis.won_n}} of {{second_ball_kpis.n}})</span></div><img class="chart" src="{{second_ball_img}}"></div></div>{{footer(14 if tracked_shapes else 13)}}</section>
<section class="sheet title">{{mast('Transition','DIVIDER')}}<div class="titlebody"><div class="num">4</div><h1>Transition</h1><hr><p>Whether {{subject}} controlled the immediate response after losing the ball.</p><div class="contents"><span>High attacking-half losses</span><br><span>Counter-press regains</span><br><span>Losses leading to shots</span></div></div>{{footer(15 if tracked_shapes else 14)}}</section>
<section class="sheet">{{header('Defensive Transition Response','Transition','PAGE 1/1','what happened after '+subject+' lost the ball in the attacking half')}}<div class="card hero"><img class="chart" src="{{transition_img}}"><p class="muted" style="text-align:center;font-style:italic">red circle = high loss · black cross = opposition shot within 15s · green triangle = counter-press regain within 5s</p></div><div style="display:flex;justify-content:space-between;padding:1mm 0;font-size:6pt;color:#6f6a5d"><span>● Loss (attacking half)</span><span>✕ Loss → opponent shot within 15s</span><span>▲ Counter-press regain (within 5s)</span></div><div class="kpis2"><div class="kpi2"><b>{{transition_kpis.high_losses_n}}</b><span>High losses</span></div><div class="kpi2"><b>{{transition_kpis.counterpress_n}}</b><span>Counter-press regains</span></div><div class="kpi2"><b>{{transition_kpis.shot_n}}</b><span>Led to opponent shot</span></div><div class="kpi2"><b>{{transition_kpis.shot_pct}}%</b><span>Loss-to-shot rate</span></div></div>{{footer(16 if tracked_shapes else 15)}}</section>
</body></html>
